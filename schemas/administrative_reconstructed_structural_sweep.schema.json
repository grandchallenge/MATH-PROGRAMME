{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/administrative_reconstructed_structural_sweep.schema.json",
  "title": "Belated reconstructed administrative structural sweep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sweep_id",
    "control_id",
    "reconciliation_id",
    "status",
    "scheduled_due_at",
    "reconstruction_started_at",
    "lateness_minutes_at_start",
    "cadence",
    "evidence_mode",
    "programme_head_at_due",
    "programme_head_at_due_source",
    "repository_inventory_reference",
    "dispatcher_reconciliation",
    "findings",
    "next_structural_due_at",
    "pilot_review_due_at",
    "waiver_used",
    "cadence_anchor_reset",
    "claim_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "sweep_id": {"type": "string", "pattern": "^MP-ADMIN-STRUCTURAL-SWEEP-2026-08-(02|03|04)-00[2-5]$"},
    "control_id": {"const": "MP-ADMIN-MAINT-001"},
    "reconciliation_id": {"const": "MP-ADMIN-CADENCE-RECONCILIATION-001"},
    "status": {"const": "COMPLETE_BELATED_RECONSTRUCTED_P2"},
    "scheduled_due_at": {"type": "string", "format": "date-time"},
    "reconstruction_started_at": {"const": "2026-08-04T16:42:38-07:00"},
    "lateness_minutes_at_start": {"type": "integer", "minimum": 1},
    "cadence": {"const": "PT16H48M"},
    "evidence_mode": {"const": "RETROSPECTIVE_RECONSTRUCTION"},
    "programme_head_at_due": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "programme_head_at_due_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_until_utc", "observed_commit_timestamp", "classification"],
      "properties": {
        "query_until_utc": {"type": "string", "format": "date-time"},
        "observed_commit_timestamp": {"type": "string", "format": "date-time"},
        "classification": {"const": "RETROSPECTIVE_API_RECONSTRUCTION"}
      }
    },
    "repository_inventory_reference": {"const": "governance/administrative_cadence_reconciliation.json"},
    "dispatcher_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduled_signal_expected", "protected_record_missing_at_reconstruction", "dispatch_is_not_authority"],
      "properties": {
        "scheduled_signal_expected": {"const": true},
        "protected_record_missing_at_reconstruction": {"const": true},
        "dispatch_is_not_authority": {"const": true}
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P0", "P1", "P2", "P3"],
      "properties": {
        "P0": {"type": "array", "maxItems": 0},
        "P1": {"type": "array", "maxItems": 0},
        "P2": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_id", "title", "disposition"],
            "properties": {
              "finding_id": {"type": "string", "pattern": "^MP-ADMIN-P2-2026-08-(02|03|04)-[0-9]{3}$"},
              "title": {"type": "string", "minLength": 1},
              "disposition": {"const": "BELATED_RECORD_CREATED_NO_CADENCE_RESET_NO_WAIVER"}
            }
          }
        },
        "P3": {"type": "array", "maxItems": 0}
      }
    },
    "next_structural_due_at": {"const": "2026-08-04T23:09:00-07:00"},
    "pilot_review_due_at": {"const": "2026-08-09T18:21:00-07:00"},
    "waiver_used": {"const": false},
    "cadence_anchor_reset": {"const": false},
    "claim_boundaries": {
      "type": "object",
      "minProperties": 13,
      "additionalProperties": {"const": false}
    }
  }
}
