{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/gcl_local_identity_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity_manifest_id",
    "repository",
    "subject",
    "files",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "identity_manifest_id": {
      "type": "string",
      "pattern": "^GCL-ID-[A-Z0-9-]+$"
    },
    "repository": {
      "type": "string",
      "pattern": "^grandchallenge/[A-Za-z0-9_.-]+$"
    },
    "subject": {"type": "string", "minLength": 3},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "git_blob_sha1"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_evidence_only", "may_authorize_promotion"],
      "properties": {
        "candidate_evidence_only": {"const": true},
        "may_authorize_promotion": {"const": false}
      }
    }
  }
}
