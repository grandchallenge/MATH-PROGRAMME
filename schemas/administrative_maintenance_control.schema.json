{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/administrative_maintenance_control.schema.json",
  "title": "MATH-PROGRAMME Administrative Maintenance Control",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "control_id",
    "title",
    "status",
    "effective",
    "prepared_at",
    "programme_issue",
    "council_issue",
    "foundation",
    "core_clarity_invariants",
    "repository_roles",
    "control_loops",
    "material_change_classification",
    "workflow_coverage_requirements",
    "tracker_hygiene",
    "freshness_policy",
    "waiver_policy",
    "independent_review_policy",
    "emergency_override_policy",
    "maintenance_burden_circuit_breaker",
    "communication_profile",
    "council_decisions",
    "promotion_gate",
    "claim_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "control_id": {"const": "MP-ADMIN-MAINT-001"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["CANDIDATE_PENDING_COUNCIL_DECISION", "APPROVED_PILOT", "BINDING", "RETURNED", "REJECTED", "SUPERSEDED"]},
    "effective": {"type": "boolean"},
    "prepared_at": {"type": "string", "format": "date"},
    "programme_issue": {"const": 182},
    "council_issue": {"const": 183},
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "seventh_pass_merge", "seventh_pass_record", "seventh_pass_record_blob"],
      "properties": {
        "repository": {"const": "grandchallenge/MATH-PROGRAMME"},
        "seventh_pass_merge": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "seventh_pass_record": {"const": "governance/five_repository_conformance_seventh_pass_closure.json"},
        "seventh_pass_record_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "core_clarity_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protected_records_are_state_authority",
        "mutable_issues_are_navigation_only",
        "repository_head_is_distinct_from_material_artifact_identity",
        "unchanged_material_artifacts_do_not_require_repin",
        "historical_records_are_immutable",
        "historical_records_require_successor_or_supersession_semantics",
        "missing_stale_contradictory_or_unreviewed_evidence_fails_closed",
        "interface_qualification_is_not_theorem_proof",
        "presentation_cannot_create_authority",
        "administrative_maintenance_cannot_promote_external_claims"
      ],
      "properties": {
        "protected_records_are_state_authority": {"const": true},
        "mutable_issues_are_navigation_only": {"const": true},
        "repository_head_is_distinct_from_material_artifact_identity": {"const": true},
        "unchanged_material_artifacts_do_not_require_repin": {"const": true},
        "historical_records_are_immutable": {"const": true},
        "historical_records_require_successor_or_supersession_semantics": {"const": true},
        "missing_stale_contradictory_or_unreviewed_evidence_fails_closed": {"const": true},
        "interface_qualification_is_not_theorem_proof": {"const": true},
        "presentation_cannot_create_authority": {"const": true},
        "administrative_maintenance_cannot_promote_external_claims": {"const": true}
      }
    },
    "repository_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["math_programme", "mathforge", "mathsolve", "mathcert", "intellect"],
      "properties": {
        "math_programme": {"$ref": "#/$defs/repositoryRole"},
        "mathforge": {"$ref": "#/$defs/repositoryRole"},
        "mathsolve": {"$ref": "#/$defs/repositoryRole"},
        "mathcert": {"$ref": "#/$defs/repositoryRole"},
        "intellect": {"$ref": "#/$defs/repositoryRole"}
      }
    },
    "control_loops": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_triggered_synchronization", "weekly_structural_sweep", "monthly_administrative_review", "quarterly_deep_conformance_review", "annual_constitutional_review"],
      "properties": {
        "event_triggered_synchronization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["binding", "trigger_classes", "required_actions", "failure_disposition"],
          "properties": {
            "binding": {"const": true},
            "trigger_classes": {"$ref": "#/$defs/nonEmptyStringArray"},
            "required_actions": {"$ref": "#/$defs/nonEmptyStringArray"},
            "failure_disposition": {"const": "FAIL_CLOSED_MATERIAL_SYNC_INCOMPLETE"}
          }
        },
        "weekly_structural_sweep": {"$ref": "#/$defs/provisionalLoop"},
        "monthly_administrative_review": {"$ref": "#/$defs/provisionalLoop"},
        "quarterly_deep_conformance_review": {"$ref": "#/$defs/provisionalLoop"},
        "annual_constitutional_review": {"$ref": "#/$defs/provisionalLoop"}
      }
    },
    "material_change_classification": {"$ref": "#/$defs/materialClassification"},
    "workflow_coverage_requirements": {"$ref": "#/$defs/workflowCoverage"},
    "tracker_hygiene": {"$ref": "#/$defs/trackerHygiene"},
    "freshness_policy": {"$ref": "#/$defs/freshnessPolicy"},
    "waiver_policy": {"$ref": "#/$defs/waiverPolicy"},
    "independent_review_policy": {"$ref": "#/$defs/independentReviewPolicy"},
    "emergency_override_policy": {"$ref": "#/$defs/emergencyPolicy"},
    "maintenance_burden_circuit_breaker": {"$ref": "#/$defs/circuitBreaker"},
    "communication_profile": {"$ref": "#/$defs/communicationProfile"},
    "council_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8"],
      "properties": {
        "D1": {"$ref": "#/$defs/decisionState"},
        "D2": {"$ref": "#/$defs/decisionState"},
        "D3": {"$ref": "#/$defs/decisionState"},
        "D4": {"$ref": "#/$defs/decisionState"},
        "D5": {"$ref": "#/$defs/decisionState"},
        "D6": {"$ref": "#/$defs/decisionState"},
        "D7": {"$ref": "#/$defs/decisionState"},
        "D8": {"$ref": "#/$defs/decisionState"}
      }
    },
    "promotion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_valid", "semantic_tests_required", "adversarial_tests_required", "programme_policy_checks_required", "gcl_conformance_required", "council_decisions_resolved", "non_author_referee_review_required", "human_steward_release_required", "may_promote_now"],
      "properties": {
        "schema_valid": {"type": "boolean"},
        "semantic_tests_required": {"const": true},
        "adversarial_tests_required": {"const": true},
        "programme_policy_checks_required": {"const": true},
        "gcl_conformance_required": {"const": true},
        "council_decisions_resolved": {"type": "boolean"},
        "non_author_referee_review_required": {"const": true},
        "human_steward_release_required": {"const": true},
        "may_promote_now": {"type": "boolean"}
      }
    },
    "claim_boundaries": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {"const": false}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "CANDIDATE_PENDING_COUNCIL_DECISION"}}},
      "then": {
        "properties": {
          "effective": {"const": false},
          "promotion_gate": {
            "properties": {
              "council_decisions_resolved": {"const": false},
              "may_promote_now": {"const": false}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "repositoryRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "responsibilities"],
      "properties": {
        "repository": {"type": "string", "pattern": "^grandchallenge/[A-Z-]+$"},
        "responsibilities": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "provisionalLoop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "proposed_cadence", "council_decision", "checks", "evidence"],
      "properties": {
        "binding": {"const": false},
        "proposed_cadence": {"type": "string", "pattern": "^P"},
        "council_decision": {"const": "D1"},
        "checks": {"$ref": "#/$defs/nonEmptyStringArray"},
        "owner": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "materialClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_changes", "nonmaterial_changes", "classification_evidence_required", "uncertain_classification_disposition"],
      "properties": {
        "material_changes": {"$ref": "#/$defs/nonEmptyStringArray"},
        "nonmaterial_changes": {"$ref": "#/$defs/nonEmptyStringArray"},
        "classification_evidence_required": {"const": true},
        "uncertain_classification_disposition": {"const": "ESCALATE_AND_FAIL_CLOSED"}
      }
    },
    "workflowCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_definition", "required_capabilities", "required_fields_per_capability", "missing_required_capability_disposition", "yaml_presence_alone_is_sufficient"],
      "properties": {
        "coverage_definition": {"type": "string", "minLength": 1},
        "required_capabilities": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_fields_per_capability": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "missing_required_capability_disposition": {"const": "FAIL_CLOSED_WORKFLOW_COVERAGE_INCOMPLETE"},
        "yaml_presence_alone_is_sufficient": {"const": false}
      }
    },
    "trackerHygiene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_tracker_required_sections", "tracker_can_create_authority", "proposed_refresh_target", "refresh_target_binding", "council_decision", "contradictory_tracker_blocks_reconciliation_closure", "stale_tracker_overrides_protected_state"],
      "properties": {
        "canonical_tracker_required_sections": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tracker_can_create_authority": {"const": false},
        "proposed_refresh_target": {"type": "string", "pattern": "^P"},
        "refresh_target_binding": {"const": false},
        "council_decision": {"const": "D2"},
        "contradictory_tracker_blocks_reconciliation_closure": {"const": true},
        "stale_tracker_overrides_protected_state": {"const": false}
      }
    },
    "freshnessClock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposed_rule", "binding", "council_decision"],
      "properties": {
        "proposed_rule": {"type": "string", "minLength": 1},
        "binding": {"const": false},
        "council_decision": {"const": "D2"}
      }
    },
    "freshnessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected_material_sync", "tracker_refresh", "routine_review_expiry", "stale_or_contradictory_protected_current_state_disposition"],
      "properties": {
        "protected_material_sync": {"$ref": "#/$defs/freshnessClock"},
        "tracker_refresh": {"$ref": "#/$defs/freshnessClock"},
        "routine_review_expiry": {"$ref": "#/$defs/freshnessClock"},
        "stale_or_contradictory_protected_current_state_disposition": {"const": "FAIL_CLOSED_IMMEDIATELY"}
      }
    },
    "waiverPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "council_decision", "required_fields", "proposed_steward_limit", "proposed_maximum_renewals", "council_required_for", "claim_promotion_by_waiver_allowed"],
      "properties": {
        "binding": {"const": false},
        "council_decision": {"const": "D3"},
        "required_fields": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "proposed_steward_limit": {"type": "string", "pattern": "^P"},
        "proposed_maximum_renewals": {"type": "integer", "minimum": 0},
        "council_required_for": {"$ref": "#/$defs/nonEmptyStringArray"},
        "claim_promotion_by_waiver_allowed": {"const": false}
      }
    },
    "independentReviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "council_decision", "proposed_referee_triggers", "routine_identity_repin_requires_independent_referee", "routine_mirror_refresh_requires_independent_referee"],
      "properties": {
        "binding": {"const": false},
        "council_decision": {"const": "D4"},
        "proposed_referee_triggers": {"$ref": "#/$defs/nonEmptyStringArray"},
        "routine_identity_repin_requires_independent_referee": {"const": false},
        "routine_mirror_refresh_requires_independent_referee": {"const": false}
      }
    },
    "emergencyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "council_decision", "permitted_purpose", "proposed_maximum_duration", "prohibited_actions", "proposed_steward_review_deadline", "proposed_council_and_referee_retrospective_deadline", "automatic_expiry_required", "fail_closed_reversion_required"],
      "properties": {
        "binding": {"const": false},
        "council_decision": {"const": "D6"},
        "permitted_purpose": {"$ref": "#/$defs/nonEmptyStringArray"},
        "proposed_maximum_duration": {"type": "string", "pattern": "^P"},
        "prohibited_actions": {"$ref": "#/$defs/nonEmptyStringArray"},
        "proposed_steward_review_deadline": {"type": "string", "pattern": "^P"},
        "proposed_council_and_referee_retrospective_deadline": {"type": "string", "pattern": "^P"},
        "automatic_expiry_required": {"const": true},
        "fail_closed_reversion_required": {"const": true}
      }
    },
    "circuitBreaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "council_decision", "proposed_triggers", "proposed_immediate_action", "available_council_dispositions"],
      "properties": {
        "binding": {"const": false},
        "council_decision": {"const": "D7"},
        "proposed_triggers": {"$ref": "#/$defs/nonEmptyStringArray"},
        "proposed_immediate_action": {"const": "FREEZE_NEW_CAMPAIGN_ADMISSION_PENDING_COUNCIL_REVIEW"},
        "available_council_dispositions": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "communicationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["council_decision", "gcl_tcs_00_pilot_principles_may_be_used", "gcl_tcs_00_binding", "binding_preconditions", "canonical_mathematical_claim_ledger_remains_controlling"],
      "properties": {
        "council_decision": {"const": "D8"},
        "gcl_tcs_00_pilot_principles_may_be_used": {"const": true},
        "gcl_tcs_00_binding": {"const": false},
        "binding_preconditions": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "canonical_mathematical_claim_ledger_remains_controlling": {"const": true}
      }
    },
    "decisionState": {
      "enum": ["PENDING", "APPROVE", "APPROVE_WITH_CORRECTION", "RETURN_FOR_REVISION", "REJECT"]
    }
  }
}
