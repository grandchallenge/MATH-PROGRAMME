{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.github.io/MATH-PROGRAMME/schemas/documentary_manifest.schema.json",
  "title": "MATH-PROGRAMME Documentary Library manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection",
    "style",
    "generated_on",
    "artifact_policy",
    "volumes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "collection": {
      "const": "MATH-PROGRAMME Documentary Library"
    },
    "style": {
      "const": "GCL–Chaidez"
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "artifact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git",
        "authoritative_source",
        "rendered_edition",
        "web_edition",
        "integrity",
        "availability",
        "discovery_authority"
      ],
      "properties": {
        "git": {
          "const": "source records, edition records, and metadata"
        },
        "authoritative_source": {
          "const": "checksum-locked complete illustrated source bundle"
        },
        "rendered_edition": {
          "const": "checksum-locked PDF"
        },
        "web_edition": {
          "const": "derivative public presentation"
        },
        "integrity": {
          "const": "SHA-256 and byte length"
        },
        "availability": {
          "const": "explicit per release-class artifact"
        },
        "discovery_authority": {
          "const": "ARTIFACT_MANIFEST.json"
        }
      }
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/volume"
      }
    }
  },
  "$defs": {
    "release_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256",
        "availability",
        "release_locator"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "availability": {
          "type": "string",
          "enum": [
            "metadata_only",
            "published_release"
          ]
        },
        "release_locator": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "published_release"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "release_locator": {
                "type": "string",
                "format": "uri",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "const": "metadata_only"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "release_locator": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "domain_id",
        "campaign_id",
        "scope_relation",
        "documentary_tier",
        "title",
        "topic",
        "status",
        "pages",
        "source_record",
        "web_page",
        "edition_record",
        "claim_authority",
        "rendered_pdf",
        "latex_source",
        "authoritative_source_bundle"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "domain_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_relation": {
          "type": "string",
          "enum": [
            "campaign_documentary",
            "parent_challenge_orientation",
            "solved_theorem_archive"
          ]
        },
        "documentary_tier": {
          "type": "string",
          "enum": [
            "reference",
            "full",
            "orientation"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "source_record": {
          "type": "string",
          "pattern": "^sources/[A-Za-z0-9_./-]+\\.tex$"
        },
        "web_page": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.md$"
        },
        "edition_record": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.edition\\.json$"
        },
        "claim_authority": {
          "type": "string",
          "minLength": 1
        },
        "rendered_pdf": {
          "$ref": "#/$defs/release_artifact"
        },
        "latex_source": {
          "$ref": "#/$defs/release_artifact"
        },
        "authoritative_source_bundle": {
          "$ref": "#/$defs/release_artifact"
        }
      }
    }
  }
}
