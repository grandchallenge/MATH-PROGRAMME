{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.github.io/MATH-PROGRAMME/schemas/governed_closure_contract.schema.json",
  "title": "Governed Documentary Closure Contract",
  "description": "Terminal continuity contract for governed operations that do not use a schema-bound Agent Council review record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "governed_work_id",
    "binding",
    "artifact_ledger",
    "review_provenance",
    "cross_document_consistency",
    "final_editorial_integration",
    "unresolved_documentary_obligations",
    "authority_refs",
    "terminal_evidence_refs",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "governed_work_id": {"type": "string", "minLength": 1},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "policy_refs", "legacy_boundary"],
      "properties": {
        "status": {"const": "CANONICAL_ON_PROTECTED_MAIN"},
        "policy_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "legacy_boundary": {"type": "string", "minLength": 1}
      }
    },
    "artifact_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_ref", "entry_id"],
      "properties": {
        "ledger_ref": {"type": "string", "minLength": 1},
        "entry_id": {"type": "string", "minLength": 1}
      }
    },
    "review_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "evidence_refs"],
      "properties": {
        "complete": {"const": true},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "cross_document_consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_against", "conflicts"],
      "properties": {
        "status": {"const": "reviewed"},
        "checked_against": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "conflicts": {"type": "array", "maxItems": 0}
      }
    },
    "final_editorial_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authoritative_artifact_ref", "integration_notes"],
      "properties": {
        "status": {"const": "reviewed"},
        "authoritative_artifact_ref": {"type": "string", "minLength": 1},
        "integration_notes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "unresolved_documentary_obligations": {
      "type": "array",
      "maxItems": 0
    },
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "terminal_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creates_new_authority",
        "creates_mathematical_claim",
        "creates_certification_claim",
        "creates_external_claim_authority"
      ],
      "properties": {
        "creates_new_authority": {"type": "boolean"},
        "creates_mathematical_claim": {"type": "boolean"},
        "creates_certification_claim": {"type": "boolean"},
        "creates_external_claim_authority": {"type": "boolean"}
      }
    }
  }
}
