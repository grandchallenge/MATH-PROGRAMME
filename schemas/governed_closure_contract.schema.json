{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.github.io/MATH-PROGRAMME/schemas/governed_closure_contract.schema.json",
  "title": "Governed Documentary Closure Contract",
  "description": "Continuity contract for governed operations that do not use a schema-bound Agent Council review record. Candidate contracts may await protected admission; canonical contracts must carry exact terminal admission evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "governed_work_id",
    "binding",
    "artifact_ledger",
    "review_provenance",
    "cross_document_consistency",
    "final_editorial_integration",
    "unresolved_documentary_obligations",
    "authority_refs",
    "terminal_evidence_refs",
    "admission",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "governed_work_id": {"type": "string", "minLength": 1},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "policy_refs", "legacy_boundary"],
      "properties": {
        "status": {
          "enum": [
            "CANDIDATE_AWAITING_PROTECTED_ADMISSION",
            "CANONICAL_ON_PROTECTED_MAIN"
          ]
        },
        "policy_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "legacy_boundary": {"type": "string", "minLength": 1}
      }
    },
    "artifact_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_ref", "entry_id"],
      "properties": {
        "ledger_ref": {"type": "string", "minLength": 1},
        "entry_id": {"type": "string", "minLength": 1}
      }
    },
    "review_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "evidence_refs"],
      "properties": {
        "complete": {"type": "boolean"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "cross_document_consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_against", "conflicts"],
      "properties": {
        "status": {"enum": ["pending", "reviewed"]},
        "checked_against": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "conflicts": {"type": "array"}
      }
    },
    "final_editorial_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authoritative_artifact_ref", "integration_notes"],
      "properties": {
        "status": {"enum": ["pending", "reviewed"]},
        "authoritative_artifact_ref": {"type": "string", "minLength": 1},
        "integration_notes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "unresolved_documentary_obligations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "terminal_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "admission": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "required_next_step"],
          "properties": {
            "phase": {"const": "candidate"},
            "required_next_step": {"const": "protected_pr_admission_and_readback"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "exact_reviewed_head",
            "independent_review_id",
            "independent_reviewer",
            "programme_policy_run",
            "programme_policy_conclusion",
            "protected_merge",
            "protected_merge_signature_verified",
            "protected_merge_signature_reason",
            "protected_main_readback",
            "terminal_receipt_ref"
          ],
          "properties": {
            "phase": {"const": "protected"},
            "exact_reviewed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "independent_review_id": {"type": "string", "minLength": 1},
            "independent_reviewer": {"type": "string", "minLength": 1},
            "programme_policy_run": {"type": "integer", "minimum": 1},
            "programme_policy_conclusion": {"const": "success"},
            "protected_merge": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "protected_merge_signature_verified": {"const": true},
            "protected_merge_signature_reason": {"const": "valid"},
            "protected_main_readback": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "terminal_receipt_ref": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creates_new_authority",
        "creates_mathematical_claim",
        "creates_certification_claim",
        "creates_external_claim_authority"
      ],
      "properties": {
        "creates_new_authority": {"type": "boolean"},
        "creates_mathematical_claim": {"type": "boolean"},
        "creates_certification_claim": {"type": "boolean"},
        "creates_external_claim_authority": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "binding": {
            "properties": {"status": {"const": "CANDIDATE_AWAITING_PROTECTED_ADMISSION"}}
          }
        }
      },
      "then": {
        "properties": {
          "admission": {"properties": {"phase": {"const": "candidate"}}},
          "terminal_evidence_refs": {"maxItems": 0},
          "unresolved_documentary_obligations": {
            "minItems": 1,
            "contains": {"const": "protected_pr_admission_and_readback"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "binding": {
            "properties": {"status": {"const": "CANONICAL_ON_PROTECTED_MAIN"}}
          }
        }
      },
      "then": {
        "properties": {
          "review_provenance": {
            "properties": {"complete": {"const": true}}
          },
          "cross_document_consistency": {
            "properties": {
              "status": {"const": "reviewed"},
              "conflicts": {"maxItems": 0}
            }
          },
          "final_editorial_integration": {
            "properties": {"status": {"const": "reviewed"}}
          },
          "unresolved_documentary_obligations": {"maxItems": 0},
          "terminal_evidence_refs": {"minItems": 4},
          "admission": {"properties": {"phase": {"const": "protected"}}}
        }
      }
    }
  ]
}
