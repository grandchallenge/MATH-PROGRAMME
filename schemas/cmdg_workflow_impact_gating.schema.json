{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/cmdg_workflow_impact_gating.schema.json",
  "title": "CMDG material-closure workflow routing control",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "control_id",
    "status",
    "issue",
    "supersedes_phase",
    "phase",
    "formal_router",
    "promotion",
    "sentinel",
    "acceptance_examples",
    "routing_boundary",
    "authority_boundary",
    "terminal_target"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "control_id": {"const": "MP-CMDG-WORKFLOW-IMPACT-GATING-001"},
    "status": {"const": "ACTIVE_ON_PROTECTED_MERGE"},
    "issue": {"const": 936},
    "supersedes_phase": {"const": "CLASSIFIER_ORCHESTRATED_PROTECTED_MERGE"},
    "phase": {"const": "MATERIAL_CLOSURE_FORMAL_VALIDATION"},
    "formal_router": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "registry", "required_context", "pull_request_behavior", "merge_group_behavior", "unknown_formal_path_behavior", "control_plane_behavior"],
      "properties": {
        "workflow": {"const": ".github/workflows/formal-validation.yml"},
        "registry": {"const": "governance/formal_validation_registry.json"},
        "required_context": {"const": "formal-validation / formal-validation"},
        "pull_request_behavior": {"const": "INSTANTIATE_ONLY_MATERIALLY_SELECTED_LANES"},
        "merge_group_behavior": {"const": "PROMOTION_REPLAY_ONLY_MATERIALLY_SELECTED_LANES"},
        "unknown_formal_path_behavior": {"const": "ERROR"},
        "control_plane_behavior": {"const": "CONSERVATIVE_FULL_FANOUT"}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared_executor", "standalone_workflows", "allowed_wrapper_triggers", "chronological_predecessor_revalidation"],
      "properties": {
        "shared_executor": {"const": ".github/workflows/cmdg-formal-lane-replay.yml"},
        "standalone_workflows": {
          "type": "object",
          "minProperties": 12,
          "maxProperties": 12,
          "additionalProperties": {"type": "string", "pattern": "^cmdg-[a-z0-9-]+$"},
          "propertyNames": {"pattern": "^cmdg-.*\\.yml$"}
        },
        "allowed_wrapper_triggers": {
          "const": ["workflow_call", "workflow_dispatch"]
        },
        "chronological_predecessor_revalidation": {"const": false}
      }
    },
    "sentinel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "cron", "source_of_truth", "replays_complete_cmdg_lane_set", "uses_attestation_substitution"],
      "properties": {
        "workflow": {"const": ".github/workflows/cmdg-postmerge.yml"},
        "cron": {"const": "47 11 * * *"},
        "source_of_truth": {"const": "governance/formal_validation_registry.json"},
        "replays_complete_cmdg_lane_set": {"const": true},
        "uses_attestation_substitution": {"const": false}
      }
    },
    "acceptance_examples": {"type": "object"},
    "routing_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unrelated_pr_substantive_cmdg_instantiation", "cmdg_relevant_pr_full_standalone_family", "within_cmdg_lane_reduction", "standalone_cmdg_pr_triggers", "promotion_full_declared_lane_replay_preserved", "daily_full_cmdg_sentinel_preserved"],
      "properties": {
        "unrelated_pr_substantive_cmdg_instantiation": {"const": false},
        "cmdg_relevant_pr_full_standalone_family": {"const": false},
        "within_cmdg_lane_reduction": {"const": true},
        "standalone_cmdg_pr_triggers": {"const": false},
        "promotion_full_declared_lane_replay_preserved": {"const": true},
        "daily_full_cmdg_sentinel_preserved": {"const": true}
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mathematical_authority_conferred", "source_authority_conferred", "certification_authority_conferred", "publication_or_deployment_authority_conferred", "release_or_commercial_authority_conferred", "bypass_created", "emergency_authority_created", "direct_protected_push_authorized", "human_steward_impersonation_authorized"],
      "properties": {
        "mathematical_authority_conferred": {"const": false},
        "source_authority_conferred": {"const": false},
        "certification_authority_conferred": {"const": false},
        "publication_or_deployment_authority_conferred": {"const": false},
        "release_or_commercial_authority_conferred": {"const": false},
        "bypass_created": {"const": false},
        "emergency_authority_created": {"const": false},
        "direct_protected_push_authorized": {"const": false},
        "human_steward_impersonation_authorized": {"const": false}
      }
    },
    "terminal_target": {"const": "CMDG_MATERIAL_CLOSURE_ROUTING_PROTECTED__P3_ONLY_EDIT_INSTANTIATES_ONLY_P3_SUBSTANTIVE_LANE__PROMOTION_AND_SENTINEL_CLOSURE_PRESERVED"}
  }
}
