{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.github.io/MATH-PROGRAMME/schemas/chaidez_pedagogy.schema.json",
  "title": "Chaidez Pedagogical Protocol Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "campaign_unit",
    "result_status_fields",
    "exposition_sequence",
    "trust_quartet",
    "support_route_classes",
    "proof_debt_categories",
    "spine_node_fields",
    "escalation_gate",
    "required_work_package_artifacts",
    "external_catalog_promotion"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "protocol_id": {"const": "CHAIDEZ-PEDAGOGY-001"},
    "campaign_unit": {"const": "SINGLE_THEOREM_SPINE"},
    "result_status_fields": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "exposition_sequence": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "trust_quartet": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "support_route_classes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "proof_debt_categories": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "spine_node_fields": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "escalation_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theorem_spine_audited",
        "dependencies_named",
        "proof_debt_register_current",
        "trust_quartet_complete",
        "foundational_profile_present_or_deferred",
        "first_executable_step_present",
        "next_package_names_spine_node"
      ],
      "properties": {
        "theorem_spine_audited": {"const": true},
        "dependencies_named": {"const": true},
        "proof_debt_register_current": {"const": true},
        "trust_quartet_complete": {"const": true},
        "foundational_profile_present_or_deferred": {"const": true},
        "first_executable_step_present": {"const": true},
        "next_package_names_spine_node": {"const": true}
      }
    },
    "external_catalog_promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_entry_disposition", "full_dossier_trigger", "minimum_proposal_assurance_tier", "exact_campaign_target_assurance_tier", "automatic_promotion", "catalog_assurance_is_proof_or_certification"],
      "properties": {
        "catalog_entry_disposition": {"const": "SOURCE_RECORD_ONLY"},
        "full_dossier_trigger": {"const": "REVIEWED_PROMOTION_TO_MATHSOLVE"},
        "minimum_proposal_assurance_tier": {"const": "SEMANTICALLY_REVIEWED"},
        "exact_campaign_target_assurance_tier": {"const": "CAMPAIGN_CONCORDANT"},
        "automatic_promotion": {"const": false},
        "catalog_assurance_is_proof_or_certification": {"const": false}
      }
    },
    "required_work_package_artifacts": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  }
}
