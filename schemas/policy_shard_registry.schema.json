{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/policy_shard_registry.schema.json",
  "title": "Programme policy shard registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "shards"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"const": "MP-POLICY-SHARDS-001"},
    "shards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "fixtures", "cmdg", "administrative", "campaigns", "contracts", "docs"],
      "properties": {
        "core": {"$ref": "#/$defs/commands"},
        "fixtures": {"$ref": "#/$defs/commands"},
        "cmdg": {"$ref": "#/$defs/commands"},
        "administrative": {"$ref": "#/$defs/commands"},
        "campaigns": {"$ref": "#/$defs/commands"},
        "contracts": {"$ref": "#/$defs/commands"},
        "docs": {"$ref": "#/$defs/commands"}
      }
    }
  },
  "$defs": {
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      }
    }
  }
}
