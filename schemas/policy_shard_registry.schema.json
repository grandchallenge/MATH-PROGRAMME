{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/policy_shard_registry.schema.json",
  "title": "Programme policy shard registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "execution", "shards"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"const": "MP-POLICY-SHARDS-001"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_command_timeout_seconds", "timeout_overrides", "repository_regression_exclusions"],
      "properties": {
        "default_command_timeout_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 1800
        },
        "timeout_overrides": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/timeout_override"}
        },
        "repository_regression_exclusions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["patterns", "manifests"],
          "properties": {
            "patterns": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "manifests": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "shards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "fixtures", "cmdg", "oz", "administrative", "campaigns", "contracts", "docs", "repository-regression"],
      "properties": {
        "core": {"$ref": "#/$defs/commands"},
        "fixtures": {"$ref": "#/$defs/commands"},
        "cmdg": {"$ref": "#/$defs/commands"},
        "oz": {"$ref": "#/$defs/commands"},
        "administrative": {"$ref": "#/$defs/commands"},
        "campaigns": {"$ref": "#/$defs/commands"},
        "contracts": {"$ref": "#/$defs/commands"},
        "docs": {"$ref": "#/$defs/commands"},
        "repository-regression": {"$ref": "#/$defs/commands"}
      }
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/command"}
    },
    "timeout_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shard", "command_index", "command", "timeout_seconds", "reason"],
      "properties": {
        "shard": {
          "enum": ["core", "fixtures", "cmdg", "oz", "administrative", "campaigns", "contracts", "docs", "repository-regression"]
        },
        "command_index": {"type": "integer", "minimum": 1},
        "command": {"$ref": "#/$defs/command"},
        "timeout_seconds": {"type": "integer", "minimum": 61, "maximum": 3600},
        "reason": {"type": "string", "minLength": 20}
      }
    }
  }
}
