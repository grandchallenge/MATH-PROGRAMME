{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.github.io/MATH-PROGRAMME/schemas/campaign_replay_registry.schema.json",
  "title": "Governed campaign replay registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "discovery_globs", "entries"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "discovery_globs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "timeout_seconds", "scope"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$"},
        "command": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "scope": {"type": "string", "minLength": 20}
      }
    }
  }
}
