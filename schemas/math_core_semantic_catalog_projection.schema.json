{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/math_core_semantic_catalog_projection.schema.json",
  "title": "MATH-CORE read-only semantic catalog projection",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "projection_id", "catalog_release_id", "mathforge_commit", "node_count", "node_ranges", "typed_edges", "projection_mode", "canonical_claim_ledger_mutation", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "projection_id": {"const": "MATH-CORE-EXTERNAL-SEMANTIC-CATALOG-001"},
    "catalog_release_id": {"type": "string", "pattern": "^GCL-CATALOG-[A-Z0-9-]+$"}, "mathforge_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "node_count": {"type": "integer", "minimum": 1}, "projection_mode": {"const": "READ_ONLY_PROVENANCE_BOUND"}, "canonical_claim_ledger_mutation": {"const": false},
    "node_ranges": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["provider_id", "snapshot_id", "artifact_path", "artifact_sha256", "first_catalog_id", "last_catalog_id", "node_count", "mode"],
      "properties": {"provider_id": {"type": "string"}, "snapshot_id": {"type": "string"}, "artifact_path": {"type": "string"}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "first_catalog_id": {"type": "string"}, "last_catalog_id": {"type": "string"}, "node_count": {"type": "integer", "minimum": 1}, "mode": {"const": "READ_ONLY_PROVENANCE_BOUND"}}
    }},
    "typed_edges": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["relation_id", "subject_id", "predicate", "object_id", "review_state"],
      "properties": {"relation_id": {"type": "string"}, "subject_id": {"type": "string"}, "predicate": {"enum": ["same_statement", "formalizes", "specializes", "generalizes", "implies", "related", "duplicate_candidate", "conflicts", "rejected_match"]}, "object_id": {"type": "string"}, "review_state": {"enum": ["AUTOMATED_PROPOSAL", "HUMAN_REVIEWED", "REJECTED"]}}
    }},
    "authority_boundary": {"type": "string", "minLength": 100}
  }
}
