{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/mathforge_provider_import.schema.json",
  "title": "MATHFORGE Provider Import Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "provider_repository",
    "provider_commit",
    "verified_at",
    "verification_method",
    "expanded_evidence",
    "campaigns"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "registry_id": {"const": "MATHFORGE-PROVIDER-IMPORTS"},
    "provider_repository": {"const": "grandchallenge/MATHFORGE"},
    "provider_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verified_at": {"type": "string", "format": "date"},
    "verification_method": {"enum": ["github_contents_api_git_blob_sha1", "independent_checkout_sha256"]},
    "expanded_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "upstream_repository", "upstream_commit", "replay", "snapshot", "inventory", "claim_boundary"],
      "properties": {
        "source_id": {"const": "FC-GDM-002"},
        "upstream_repository": {"const": "google-deepmind/formal-conjectures"},
        "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_run_id", "artifact_id", "artifact_name", "archive_sha256"],
          "properties": {
            "workflow_run_id": {"type": "integer", "minimum": 1},
            "artifact_id": {"type": "integer", "minimum": 1},
            "artifact_name": {"type": "string", "minLength": 1},
            "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_name", "byte_length", "sha256", "canonical_sha256", "statement_count"],
          "properties": {
            "member_name": {"type": "string", "pattern": "^[^/]+\\.json$"},
            "byte_length": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "statement_count": {"type": "integer", "minimum": 1}
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["member_name", "byte_length", "sha256", "problem_count"],
          "properties": {
            "member_name": {"type": "string", "pattern": "^[^/]+\\.json$"},
            "byte_length": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "problem_count": {"type": "integer", "minimum": 1}
          }
        },
        "claim_boundary": {"type": "string", "minLength": 40}
      }
    },
    "campaigns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["campaign_id", "title", "disposition"],
        "properties": {
          "campaign_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
          "title": {"type": "string", "minLength": 3},
          "disposition": {"enum": ["import", "waiver"]},
          "coverage_mode": {"enum": ["native", "retrospective"]},
          "manifest_path": {"type": "string", "pattern": "^provider_manifests/[A-Z0-9-]+\\.json$"},
          "manifest_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "supplemental_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_id", "kind", "path", "git_blob_sha1", "claim_boundary"],
              "properties": {
                "artifact_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
                "kind": {"enum": ["external_formal_source_registry", "external_formal_source_lock", "formal_statement_snapshot", "formal_statement_replay_reference", "statement_concordance", "formal_source_update_ledger", "formal_source_replay_manifest", "formal_source_inventory_screen", "formal_source_tag_resolution", "formal_source_coverage_record"]},
                "path": {"type": "string", "pattern": "^(governance|formal_sources)/.+"},
                "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "claim_boundary": {"type": "string", "minLength": 40}
              }
            }
          },
          "waiver": {
            "type": "object",
            "additionalProperties": false,
            "required": ["approved_by", "reason", "scope", "review_on"],
            "properties": {
              "approved_by": {"type": "string", "minLength": 2},
              "reason": {"type": "string", "minLength": 10},
              "scope": {"type": "string", "minLength": 3},
              "review_on": {"type": "string", "format": "date"}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"disposition": {"const": "import"}}},
            "then": {
              "required": ["coverage_mode", "manifest_path", "manifest_git_blob_sha1"],
              "not": {"required": ["waiver"]}
            }
          },
          {
            "if": {"properties": {"disposition": {"const": "waiver"}}},
            "then": {
              "required": ["waiver"],
              "not": {"anyOf": [{"required": ["coverage_mode"]}, {"required": ["manifest_path"]}, {"required": ["manifest_git_blob_sha1"]}, {"required": ["supplemental_artifacts"]}]}
            }
          }
        ]
      }
    }
  }
}
