{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/mathsolve_routing_registry.schema.json",
  "title": "MATH-PROGRAMME MATHSOLVE and MATHCERT routing audit registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "provider_repository",
    "provider_commit",
    "provider_pull_request",
    "certification_provider_repository",
    "certification_provider_commit",
    "certification_provider_pull_request",
    "certification_route_registry_path",
    "certification_route_registry_git_blob_sha1",
    "verified_at",
    "predecessor",
    "campaigns"
  ],
  "properties": {
    "schema_version": {
      "const": "1.4.0"
    },
    "registry_id": {
      "const": "MATHSOLVE-ROUTING-AUDIT"
    },
    "provider_repository": {
      "const": "grandchallenge/MATHSOLVE"
    },
    "provider_commit": {
      "const": "c9b9d0122017df7a117847d9ff1c2b9f6d6b75a1"
    },
    "provider_pull_request": {
      "const": "https://github.com/grandchallenge/MATHSOLVE/pull/95"
    },
    "certification_provider_repository": {
      "const": "grandchallenge/MATHCERT"
    },
    "certification_provider_commit": {
      "const": "64e042ddb1147338ad7868a2847715fe7c1c079d"
    },
    "certification_provider_pull_request": {
      "const": "https://github.com/grandchallenge/MATHCERT/pull/79"
    },
    "certification_route_registry_path": {
      "const": "governance/certification_routes.json"
    },
    "certification_route_registry_git_blob_sha1": {
      "const": "cf876f43ae824f965a3aedf411671c110c380028"
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "audit_id",
        "status"
      ],
      "properties": {
        "path": {
          "const": "governance/mathcert_cross_repository_conformance.json"
        },
        "audit_id": {
          "const": "MP-MC-CONFORMANCE-001"
        },
        "status": {
          "const": "historical_superseded_for_current_portfolio_state"
        }
      }
    },
    "campaigns": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "campaign_id",
          "title",
          "disposition"
        ],
        "properties": {
          "campaign_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "disposition": {
            "enum": [
              "route",
              "waiver"
            ]
          },
          "coverage_mode": {
            "enum": [
              "native",
              "retrospective"
            ]
          },
          "placement": {
            "enum": [
              "solve_native",
              "programme_embedded"
            ]
          },
          "manifest_path": {
            "type": "string",
            "pattern": "^campaign_manifests/[A-Z0-9-]+\\.json$"
          },
          "manifest_git_blob_sha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "solve_work_package_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forge": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "commit_sha",
              "manifest_path",
              "manifest_git_blob_sha1"
            ],
            "properties": {
              "repository": {
                "const": "grandchallenge/MATHFORGE"
              },
              "commit_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "manifest_path": {
                "type": "string",
                "minLength": 1
              },
              "manifest_git_blob_sha1": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "cert": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "route_issue",
              "route_state",
              "handoff",
              "cert_output",
              "qualification_scope"
            ],
            "properties": {
              "repository": {
                "const": "grandchallenge/MATHCERT"
              },
              "route_issue": {
                "type": "string",
                "pattern": "^https://github.com/grandchallenge/MATHCERT/issues/[0-9]+$"
              },
              "route_state": {
                "enum": [
                  "pending",
                  "ready",
                  "submitted",
                  "certified",
                  "qualified",
                  "rejected",
                  "proof_debt"
                ]
              },
              "handoff": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repository",
                  "handoff_id",
                  "state",
                  "path",
                  "git_blob_sha1"
                ],
                "properties": {
                  "repository": {
                    "const": "grandchallenge/MATHSOLVE"
                  },
                  "handoff_id": {
                    "type": "string",
                    "pattern": "^MC-HANDOFF-[A-Z0-9-]+$"
                  },
                  "state": {
                    "enum": [
                      "pending",
                      "ready",
                      "submitted"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^cert_handoffs/[A-Z0-9-]+\\.json$"
                  },
                  "git_blob_sha1": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              },
              "cert_output": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "repository",
                      "commit_sha",
                      "path",
                      "digest_algorithm",
                      "digest"
                    ],
                    "properties": {
                      "repository": {
                        "type": "string",
                        "minLength": 3
                      },
                      "commit_sha": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "digest_algorithm": {
                        "const": "git_blob_sha1"
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                      }
                    }
                  }
                ]
              },
              "qualification_scope": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "enum": [
                      "qualified_interface_only",
                      "qualified_restricted_claims_only"
                    ]
                  }
                ]
              }
            }
          },
          "promotion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "blockers"
            ],
            "properties": {
              "state": {
                "const": "blocked"
              },
              "blockers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "waiver": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "waiver_id",
              "approved_by",
              "human_steward_authorization",
              "reason",
              "scope",
              "stages",
              "review_on"
            ],
            "properties": {
              "waiver_id": {
                "type": "string",
                "minLength": 1
              },
              "approved_by": {
                "type": "array",
                "uniqueItems": true,
                "contains": {
                  "const": "Referee"
                },
                "allOf": [
                  {
                    "contains": {
                      "const": "Steward"
                    }
                  },
                  {
                    "contains": {
                      "const": "Human Steward"
                    }
                  }
                ]
              },
              "human_steward_authorization": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 10
              },
              "scope": {
                "type": "string",
                "minLength": 3
              },
              "stages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "WP00",
                    "WP01",
                    "WP02",
                    "RESTRICTED_TARGET",
                    "MECHANISM",
                    "SPECIFICATION",
                    "REALIZATION",
                    "CONFRONTATION",
                    "JUDGMENT",
                    "INTEGRATION",
                    "CLAIM_PROMOTION"
                  ]
                }
              },
              "review_on": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "route"
                }
              }
            },
            "then": {
              "required": [
                "coverage_mode",
                "placement",
                "manifest_path",
                "manifest_git_blob_sha1",
                "solve_work_package_ids",
                "forge",
                "cert",
                "promotion"
              ],
              "not": {
                "required": [
                  "waiver"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "waiver"
                }
              }
            },
            "then": {
              "required": [
                "waiver"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "coverage_mode"
                    ]
                  },
                  {
                    "required": [
                      "placement"
                    ]
                  },
                  {
                    "required": [
                      "manifest_path"
                    ]
                  },
                  {
                    "required": [
                      "manifest_git_blob_sha1"
                    ]
                  },
                  {
                    "required": [
                      "solve_work_package_ids"
                    ]
                  },
                  {
                    "required": [
                      "forge"
                    ]
                  },
                  {
                    "required": [
                      "cert"
                    ]
                  },
                  {
                    "required": [
                      "promotion"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
