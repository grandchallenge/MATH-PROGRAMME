{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/openai_ten_proofs_current_state_sync_002.schema.json",
  "title": "OpenAI Ten Proofs current cross-repository state successor 002",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "candidate_id",
    "lifecycle_state",
    "active_campaign_member",
    "supersession",
    "ownership",
    "protected_heads",
    "formal_source_authority",
    "cert_authority",
    "permanent_successor_surfaces",
    "current_root_completed_families",
    "unresolved_family_queue",
    "execution_order",
    "preserved_limitations",
    "next_controlled_obligations",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "record_id": {
      "const": "MP-OTP-CURRENT-STATE-SYNC-002"
    },
    "candidate_id": {
      "const": "OPENAI-TEN-PROOFS-001"
    },
    "lifecycle_state": {
      "const": "four_restricted_cert_qualifications_two_additional_permanent_solve_surfaces_two_current_root_forge_clearances_six_current_root_unresolved_families"
    },
    "active_campaign_member": {
      "const": false
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_programme_record",
        "historical_umbrella_record",
        "effect"
      ],
      "properties": {
        "predecessor_programme_record": {
          "$ref": "#/$defs/predecessor"
        },
        "historical_umbrella_record": {
          "$ref": "#/$defs/predecessor"
        },
        "effect": {
          "const": "current_cross_repository_state_without_rewriting_historical_programme_records"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forge",
        "solve",
        "cert",
        "programme"
      ],
      "properties": {
        "forge": {
          "const": "source_identity_semantic_nonvacuity_and_revision_loci"
        },
        "solve": {
          "const": "producer_packets_and_handoff_provenance"
        },
        "cert": {
          "const": "route_adjudication_disposition_and_output"
        },
        "programme": {
          "const": "cross_repository_current_state_only"
        }
      }
    },
    "protected_heads": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programme_base",
        "forge_main",
        "solve_main",
        "cert_main"
      ],
      "properties": {
        "programme_base": {
          "const": "3443dc530a5645f70130afa6a417426a8696135e"
        },
        "forge_main": {
          "const": "b9dda1a5b958fd1be37a26324a025013a39584c1"
        },
        "solve_main": {
          "const": "7d1f9edf16558ba4c4396126e24fd2c9ae4826f7"
        },
        "cert_main": {
          "const": "5a69fd897f69cc3871f2138d162fb6ec897ef393"
        }
      }
    },
    "formal_source_authority": {
      "type": "object"
    },
    "cert_authority": {
      "type": "object"
    },
    "permanent_successor_surfaces": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "current_root_completed_families": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/completion"
      }
    },
    "unresolved_family_queue": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "state"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution_order": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preserved_limitations": {
      "type": "object"
    },
    "next_controlled_obligations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 900
    }
  },
  "$defs": {
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_blob_sha1",
        "mutation_prohibited"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "git_blob_sha1": {
          "pattern": "^[0-9a-f]{40}$"
        },
        "mutation_prohibited": {
          "const": true
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "tracker",
        "forge_merge",
        "audit_record_path",
        "audit_record_blob",
        "disposition",
        "solve_handoff_authorized",
        "mathcert_route_authorized"
      ],
      "properties": {
        "family": {
          "enum": [
            "OTP-A-SPHERE-PACKING",
            "OTP-H-GAPCVP"
          ]
        },
        "tracker": {
          "type": "string",
          "minLength": 1
        },
        "forge_merge": {
          "pattern": "^[0-9a-f]{40}$"
        },
        "audit_record_path": {
          "type": "string",
          "minLength": 1
        },
        "audit_record_blob": {
          "pattern": "^[0-9a-f]{40}$"
        },
        "disposition": {
          "type": "string",
          "minLength": 20
        },
        "solve_handoff_authorized": {
          "const": false
        },
        "mathcert_route_authorized": {
          "const": false
        }
      }
    }
  }
}
