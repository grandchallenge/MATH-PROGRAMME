{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/openai_ten_proofs_cert_state_sync.schema.json",
  "title": "OpenAI Ten Proofs cross-repository Cert-state sync",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "candidate_id", "tracker_issue", "lifecycle_state", "active_campaign_member", "supersession", "ownership", "forge_authority", "solve_authority", "cert_authority", "result_family_state", "tranche_totals", "remaining_state", "next_controlled_obligation", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"const": "MP-OTP-CERT-STATE-SYNC-001"},
    "candidate_id": {"const": "OPENAI-TEN-PROOFS-001"},
    "tracker_issue": {"const": 212},
    "lifecycle_state": {"const": "three_family_route_tranche_one_restricted_cert_output"},
    "active_campaign_member": {"const": false},
    "supersession": {"type": "object", "additionalProperties": false, "required": ["historical_programme_overlay", "effect"], "properties": {
      "historical_programme_overlay": {"type": "object"},
      "effect": {"const": "current_cross_repository_state_without_rewriting_historical_overlays"}
    }},
    "ownership": {"const": {
      "forge": "source_identity_semantic_nonvacuity_and_revision_loci",
      "solve": "producer_packets_and_handoff_provenance",
      "cert": "route_adjudication_disposition_and_output",
      "programme": "cross_repository_current_state_only"
    }},
    "forge_authority": {"type": "object"},
    "solve_authority": {"type": "object"},
    "cert_authority": {"type": "object"},
    "result_family_state": {"type": "array", "minItems": 3, "maxItems": 3},
    "tranche_totals": {"type": "object"},
    "remaining_state": {"type": "object"},
    "next_controlled_obligation": {"const": "OTP-J1-COMPACTNESS-CERT-EVIDENCE-REFRESH-001"},
    "claim_boundary": {"type": "string", "minLength": 500}
  }
}
