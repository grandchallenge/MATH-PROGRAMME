{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Programme domain registry",
  "type": "object",
  "required": ["domains"],
  "properties": {
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain_id",
          "slug",
          "title",
          "status",
          "forge_entry",
          "solve_entry",
          "cert_route",
          "foundational_profile",
          "next_review",
          "knowledge_graph_refs",
          "classification_mapping_refs"
        ],
        "properties": {
          "domain_id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["PLANNED", "ACTIVE", "PAUSED", "COMPLETE", "ARCHIVED"]
          },
          "forge_entry": {
            "type": "string",
            "minLength": 1
          },
          "solve_entry": {
            "type": "string",
            "minLength": 1
          },
          "cert_route": {
            "type": "string",
            "minLength": 1
          },
          "foundational_profile": {
            "$ref": "#/$defs/foundational_profile"
          },
          "next_review": {
            "type": "string",
            "minLength": 1
          },
          "knowledge_graph_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "classification_mapping_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "foundational_profile": {
      "type": "object",
      "required": [
        "carrier_type",
        "ambient_structure",
        "regularity",
        "axiom_profile",
        "witness_policy",
        "certification_target",
        "pathology_risk"
      ],
      "properties": {
        "carrier_type": {
          "enum": ["finite", "countable", "continuum", "higher_type", "categorical", "unknown"]
        },
        "ambient_structure": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "vector_space",
              "affine_space",
              "metric_space",
              "topological_space",
              "measurable_space",
              "probability_space",
              "algebraic_structure",
              "order_structure",
              "computable_presentation"
            ]
          }
        },
        "regularity": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "finite",
              "decidable",
              "computable",
              "Borel",
              "Lebesgue_measurable",
              "compact",
              "convex",
              "smooth",
              "Noetherian",
              "separable"
            ]
          }
        },
        "axiom_profile": {
          "type": "object",
          "required": ["base", "choice_usage", "excluded_middle", "large_cardinal_usage", "determinacy_usage"],
          "properties": {
            "base": {
              "enum": ["finite", "constructive", "ZF", "ZF+DC", "ZFC", "stronger", "unknown"]
            },
            "choice_usage": {
              "enum": ["none", "finite_choice", "countable_choice", "dependent_choice", "full_choice", "unknown"]
            },
            "excluded_middle": {
              "enum": ["avoided", "local", "used", "unknown"]
            },
            "large_cardinal_usage": {
              "enum": ["none", "consistency_background", "essential", "unknown"]
            },
            "determinacy_usage": {
              "enum": ["none", "local", "essential", "unknown"]
            }
          },
          "additionalProperties": false
        },
        "witness_policy": {
          "type": "object",
          "required": ["existence_claim", "witness_location"],
          "properties": {
            "existence_claim": {
              "enum": ["explicit_witness", "extractable", "nonconstructive", "contradiction_only", "unknown"]
            },
            "witness_location": {
              "enum": ["card", "solver_artifact", "certificate_artifact", "absent"]
            }
          },
          "additionalProperties": false
        },
        "certification_target": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "Lean",
              "Coq",
              "SAT_certificate",
              "SMT_certificate",
              "pseudo_boolean_certificate",
              "CAS_certificate",
              "interval_certificate",
              "human_audit"
            ]
          }
        },
        "pathology_risk": {
          "type": "object",
          "required": ["level", "notes"],
          "properties": {
            "level": {
              "enum": ["low", "medium", "high", "unknown"]
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
