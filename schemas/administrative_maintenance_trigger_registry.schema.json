{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/administrative_maintenance_trigger_registry.schema.json",
  "title": "Administrative Maintenance Trigger Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trigger_id",
    "control_id",
    "status",
    "activation",
    "workflow",
    "schedule",
    "procedures",
    "event_triggers",
    "dispatch",
    "claim_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "trigger_id": {"const": "MP-ADMIN-TRIGGER-001"},
    "control_id": {"const": "MP-ADMIN-MAINT-001"},
    "status": {"const": "PROTECTED_TRIGGER_CONTROL"},
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pull_request",
        "reviewed_head",
        "merge_commit",
        "merged_at",
        "workflow_blob",
        "delegated_review_id",
        "dispatcher_run",
        "programme_policy_run",
        "gcl_conformance_run",
        "operational_on_default_branch",
        "intellect_repin_required",
        "intellect_repin_reason"
      ],
      "properties": {
        "pull_request": {"const": 203},
        "reviewed_head": {"const": "70f8ef8600a4b219ea3915d333105f0c48233e7d"},
        "merge_commit": {"const": "e941b28dbd2daa8063fcb936dca8a525d1d8d219"},
        "merged_at": {"const": "2026-08-01T22:07:47-07:00"},
        "workflow_blob": {"const": "786a90b4242d43947fbf8fb153f5cc384e77c07d"},
        "delegated_review_id": {"const": 4837277963},
        "dispatcher_run": {"const": 30733399827},
        "programme_policy_run": {"const": 30733399846},
        "gcl_conformance_run": {"const": 30733400069},
        "operational_on_default_branch": {"const": true},
        "intellect_repin_required": {"const": false},
        "intellect_repin_reason": {"type": "string", "minLength": 1}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name", "permissions", "pinned_actions"],
      "properties": {
        "path": {"const": ".github/workflows/administrative-maintenance-dispatch.yml"},
        "name": {"const": "Administrative maintenance dispatcher"},
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contents"],
          "properties": {"contents": {"const": "read"}}
        },
        "pinned_actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkout", "setup_python", "upload_artifact"],
          "properties": {
            "checkout": {"const": "3d3c42e5aac5ba805825da76410c181273ba90b1"},
            "setup_python": {"const": "5fda3b95a4ea91299a34e894583c3862153e4b97"},
            "upload_artifact": {"const": "043fb46d1a93c77aae656e7c1c64a875d1fc6a0a"}
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "anchor",
        "anchor_utc",
        "pilot_review_due",
        "exact_pilot_crons_utc",
        "overdue_watchdog_cron_utc",
        "exact_schedule_window_minutes",
        "watchdog_window_minutes",
        "schedule_is_dispatch_not_authority",
        "cadence_anchor_may_not_reset"
      ],
      "properties": {
        "timezone": {"const": "America/Vancouver"},
        "anchor": {"const": "2026-07-31T18:21:00-07:00"},
        "anchor_utc": {"const": "2026-08-01T01:21:00Z"},
        "pilot_review_due": {"const": "2026-08-09T18:21:00-07:00"},
        "exact_pilot_crons_utc": {
          "type": "array",
          "minItems": 14,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 5}
        },
        "overdue_watchdog_cron_utc": {"const": "47 * * * *"},
        "exact_schedule_window_minutes": {"const": 180},
        "watchdog_window_minutes": {"const": 60},
        "schedule_is_dispatch_not_authority": {"const": true},
        "cadence_anchor_may_not_reset": {"const": true}
      }
    },
    "procedures": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "interval_minutes",
          "first_due_utc",
          "completed_through_utc",
          "active_through_utc",
          "required_output",
          "issue_class"
        ],
        "properties": {
          "id": {
            "enum": [
              "structural_sweep",
              "administrative_review",
              "deep_conformance_review",
              "pilot_review",
              "constitutional_review"
            ]
          },
          "interval_minutes": {"type": ["integer", "null"], "minimum": 1},
          "first_due_utc": {"type": "string", "format": "date-time"},
          "completed_through_utc": {"type": ["string", "null"], "format": "date-time"},
          "active_through_utc": {"type": "string", "format": "date-time"},
          "required_output": {"type": "string", "minLength": 1},
          "issue_class": {"type": "string", "minLength": 1}
        }
      }
    },
    "event_triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "push_main_governed_paths",
        "pull_request_lifecycle",
        "issue_lifecycle",
        "branch_protection_rule",
        "required_workflow_completion",
        "manual_dispatch"
      ],
      "properties": {
        "push_main_governed_paths": {"$ref": "#/$defs/enabledTrigger"},
        "pull_request_lifecycle": {"$ref": "#/$defs/enabledTrigger"},
        "issue_lifecycle": {"$ref": "#/$defs/enabledTrigger"},
        "branch_protection_rule": {"$ref": "#/$defs/enabledTrigger"},
        "required_workflow_completion": {"$ref": "#/$defs/enabledTrigger"},
        "manual_dispatch": {"$ref": "#/$defs/enabledTrigger"}
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "artifact_name",
        "delivery_channels",
        "deduplication",
        "tracker_refresh_deadline_minutes",
        "may_create_issue",
        "may_create_protected_authority",
        "may_reset_schedule_anchor",
        "may_close_or_merge"
      ],
      "properties": {
        "repository": {"const": "grandchallenge/MATH-PROGRAMME"},
        "artifact_name": {"const": "administrative-maintenance-dispatch"},
        "delivery_channels": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "workflow_run",
              "workflow_summary",
              "workflow_annotations",
              "retained_json_artifact"
            ]
          }
        },
        "deduplication": {"const": "stable dispatch key with bounded exact-schedule and watchdog windows"},
        "tracker_refresh_deadline_minutes": {"const": 432},
        "may_create_issue": {"const": false},
        "may_create_protected_authority": {"const": false},
        "may_reset_schedule_anchor": {"const": false},
        "may_close_or_merge": {"const": false}
      }
    },
    "claim_boundaries": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {"const": false}
    }
  },
  "$defs": {
    "enabledTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "purpose"],
      "properties": {
        "enabled": {"const": true},
        "purpose": {"type": "string", "minLength": 1}
      }
    }
  }
}
