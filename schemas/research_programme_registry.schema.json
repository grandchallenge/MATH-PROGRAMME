{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/research_programme_registry.schema.json",
  "title": "GCL adjacent research programme registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "status", "programmes", "claim_boundaries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"const": "GCL-RESEARCH-PROGRAMMES-001"},
    "status": {"const": "candidate_pending_cross_repository_admission"},
    "programmes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "repository", "title", "programme_state", "source", "profile", "taxonomy", "routing", "authority_boundary", "unresolved_obligations"],
        "properties": {
          "identifier": {"pattern": "^[A-Z][A-Z0-9-]+$"},
          "repository": {"pattern": "^grandchallenge/[A-Za-z0-9._-]+$"},
          "title": {"type": "string", "minLength": 3},
          "programme_state": {"enum": ["candidate", "adopted", "superseded"]},
          "source": {"$ref": "#/$defs/exact_ref"},
          "profile": {"$ref": "#/$defs/exact_ref"},
          "taxonomy": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["scientific-computing", "numerical-linear-algebra", "neural-systems", "research-infrastructure"]}
          },
          "routing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_owner", "work_package_owner", "mathematical_certification_owner"],
            "properties": {
              "source_owner": {"const": "grandchallenge/BUTTERFLY"},
              "work_package_owner": {"const": "grandchallenge/BUTTERFLY"},
              "mathematical_certification_owner": {"const": "grandchallenge/MATHCERT"}
            }
          },
          "authority_boundary": {"type": "string", "minLength": 80},
          "unresolved_obligations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}}
        }
      }
    },
    "claim_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admits_programme", "promotes_scientific_claims", "certifies_mathematics", "authorizes_publication", "transfers_source_ownership"],
      "properties": {
        "admits_programme": {"const": false},
        "promotes_scientific_claims": {"const": false},
        "certifies_mathematics": {"const": false},
        "authorizes_publication": {"const": false},
        "transfers_source_ownership": {"const": false}
      }
    }
  },
  "$defs": {
    "exact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "commit"],
      "properties": {
        "repository": {"pattern": "^grandchallenge/[A-Za-z0-9._-]+$"},
        "path": {"type": "string", "minLength": 1},
        "commit": {"pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
