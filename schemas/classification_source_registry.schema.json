{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Classification and discovery source registry",
  "type": "object",
  "required": ["registry_version", "sources"],
  "properties": {
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "name",
          "role",
          "version_policy",
          "license",
          "terms_url",
          "retrieved_at"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "CANONICAL_CLASSIFICATION",
              "MATH_LITERATURE_DISCOVERY",
              "SEMANTIC_CITATION_DISCOVERY",
              "CURRENT_AWARENESS",
              "DESIGN_REFERENCE"
            ]
          },
          "version_policy": {
            "type": "string",
            "minLength": 1
          },
          "api_base_url": {
            "type": "string",
            "format": "uri"
          },
          "repository_url": {
            "type": "string",
            "format": "uri"
          },
          "pinned_revision": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "terms_url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
