{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Classification and discovery source registry",
  "type": "object",
  "required": ["registry_version", "sources"],
  "properties": {
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "name",
          "role",
          "version_policy",
          "license",
          "terms_url",
          "retrieved_at",
          "qualification_status",
          "runtime_authority",
          "license_review"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "NORMATIVE_SUBJECT_SPINE",
              "MACHINE_SERIALIZATION_CANDIDATE",
              "MATH_LITERATURE_DISCOVERY",
              "SEMANTIC_CITATION_DISCOVERY",
              "CURRENT_AWARENESS",
              "DESIGN_REFERENCE"
            ]
          },
          "qualification_status": {
            "enum": [
              "QUALIFIED_NORMATIVE_REFERENCE",
              "UNQUALIFIED_CANDIDATE",
              "PROVIDER_MANAGED",
              "PROGRAMME_OWNED"
            ]
          },
          "runtime_authority": {
            "type": "boolean"
          },
          "version_policy": {
            "type": "string",
            "minLength": 1
          },
          "api_base_url": {
            "type": "string",
            "format": "uri"
          },
          "repository_url": {
            "type": "string",
            "format": "uri"
          },
          "pinned_revision": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "terms_url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "candidate_payloads": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "blocking_findings": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "fallback_behavior": {
            "type": "string",
            "minLength": 1
          },
          "license_review": {
            "type": "object",
            "required": ["status", "reviewed_at", "scope", "evidence"],
            "properties": {
              "status": {
                "enum": [
                  "REFERENCE_ONLY",
                  "REVIEW_REQUIRED_BEFORE_REDISTRIBUTION",
                  "APPROVED_FOR_RECORDED_SCOPE"
                ]
              },
              "reviewed_at": {"type": "string", "format": "date"},
              "scope": {"type": "string", "minLength": 1},
              "evidence": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
