{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.github.io/MATH-PROGRAMME/schemas/documentary_candidate_registry.schema.json",
  "title": "MATH-PROGRAMME pre-admission documentary candidate registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "public_metadata",
    "source_pointer_policy",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "authority": {
      "const": "pre_admission_documentary_candidates"
    },
    "public_metadata": {
      "const": true
    },
    "source_pointer_policy": {
      "const": "repository_only_until_manifest_admission"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "release_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256",
        "availability",
        "release_locator"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "availability": {
          "const": "metadata_only"
        },
        "release_locator": {
          "type": "null"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "domain_id",
        "campaign_id",
        "scope_relation",
        "proposed_documentary_tier",
        "title",
        "topic",
        "claim_status",
        "problem_class",
        "display_status",
        "claim_authority",
        "source_record",
        "source_lock",
        "review_record",
        "admission_state",
        "manifest_member",
        "public_copy_policy",
        "admission_obligations",
        "release_artifacts"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "domain_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_relation": {
          "enum": [
            "campaign_documentary",
            "parent_challenge_orientation"
          ]
        },
        "proposed_documentary_tier": {
          "enum": [
            "full",
            "orientation"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "claim_status": {
          "const": "open"
        },
        "problem_class": {
          "enum": [
            "open_conjecture",
            "millennium_open_problem"
          ]
        },
        "display_status": {
          "type": "string",
          "minLength": 1
        },
        "claim_authority": {
          "type": "string",
          "minLength": 1
        },
        "source_record": {
          "type": "string",
          "pattern": "^campaigns/[A-Za-z0-9_./-]+\\.tex$"
        },
        "source_lock": {
          "type": "string",
          "pattern": "^campaigns/[A-Za-z0-9_./-]+\\.json$"
        },
        "review_record": {
          "type": "string",
          "pattern": "^reviews/[A-Za-z0-9_./-]+\\.ya?ml$"
        },
        "admission_state": {
          "const": "source_locked_web_admission_pending"
        },
        "manifest_member": {
          "const": false
        },
        "public_copy_policy": {
          "const": "metadata_public_source_record_repository_only"
        },
        "admission_obligations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "release_artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rendered_pdf",
            "latex_source",
            "authoritative_source_bundle"
          ],
          "properties": {
            "rendered_pdf": {
              "$ref": "#/$defs/release_artifact"
            },
            "latex_source": {
              "$ref": "#/$defs/release_artifact"
            },
            "authoritative_source_bundle": {
              "$ref": "#/$defs/release_artifact"
            }
          }
        }
      }
    }
  }
}
