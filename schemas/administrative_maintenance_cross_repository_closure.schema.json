  "properties": {
    "schema_version": {"const": "1.0.0"},
    "closure_id": {"const": "MP-ADMIN-CLOSURE-001"},
    "control_id": {"const": "MP-ADMIN-MAINT-001"},
    "decision_id": {"const": "MP-ADMIN-DECISION-001"},
    "status": {"const": "FINAL_CROSS_REPOSITORY_CLOSURE"},
    "closed_at": {"const": "2026-07-31T18:21:00-07:00"},
    "human_steward": {"const": "fyremael"},
    "programme": {
      "type": "object",
