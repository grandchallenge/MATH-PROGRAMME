    "pilot_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "review_due_at", "review_interval", "structural_first_due_at", "administrative_first_due_at"],
      "properties": {
        "started_at": {"const": "2026-07-31T18:21:00-07:00"},
        "review_due_at": {"const": "2026-08-09T18:21:00-07:00"},
        "review_interval": {"const": "P9D"},
        "structural_first_due_at": {"const": "2026-08-01T11:09:00-07:00"},
        "administrative_first_due_at": {"const": "2026-08-03T18:21:00-07:00"}
      }
    },
    "post_merge_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "final_programme_closure_merge", "required_after_merge"],
      "properties": {
        "location": {"type": "string", "minLength": 1},
        "final_programme_closure_merge": {"type": "null"},
        "required_after_merge": {"const": true}
      }
    },
    "claim_boundaries": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {"const": false}
    }
