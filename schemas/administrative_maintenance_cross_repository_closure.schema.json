{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/administrative_maintenance_cross_repository_closure.schema.json",
  "title": "Administrative Maintenance Cross-Repository Closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "closure_id",
    "control_id",
    "decision_id",
    "status",
    "closed_at",
    "human_steward",
    "programme",
    "intellect",
    "accelerated_schedule",
    "dispositions",
    "identity_mismatch_counts",
    "unchanged_provider_disposition",
    "pilot_activation",
    "post_merge_attestation",
    "claim_boundaries"
