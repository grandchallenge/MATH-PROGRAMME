{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/release_trust_admin_contract.schema.json",
  "title": "Release-trust administration contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_id",
    "api_version",
    "administration_secret",
    "pages",
    "repositories",
    "branch_policy",
    "issues",
    "closure_rule"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "ORG-REL-TRUST-01"},
    "api_version": {"const": "2022-11-28"},
    "administration_secret": {"const": "GCL_REPOSITORY_ADMIN_TOKEN"},
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "homepage", "revision_marker_url", "workflow_file", "issue"],
      "properties": {
        "repository": {"const": "grandchallenge/MATH-PROGRAMME"},
        "branch": {"const": "main"},
        "homepage": {"const": "https://grandchallenge.github.io/MATH-PROGRAMME/"},
        "revision_marker_url": {"const": "https://grandchallenge.github.io/MATH-PROGRAMME/release-trust.json"},
        "workflow_file": {"const": "pages.yml"},
        "issue": {"const": 7}
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "branch", "required_checks"],
        "properties": {
          "repository": {
            "enum": [
              "grandchallenge/MATHCERT",
              "grandchallenge/MATHSOLVE",
              "grandchallenge/MATH-PROGRAMME",
              "grandchallenge/INTELLECT"
            ]
          },
          "branch": {"const": "main"},
          "required_checks": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "branch_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strict_status_checks",
        "enforce_admins",
        "required_approving_reviews",
        "dismiss_stale_reviews",
        "require_last_push_approval",
        "require_code_owner_reviews",
        "required_conversation_resolution",
        "allow_force_pushes",
        "allow_deletions",
        "required_linear_history",
        "bypass_actors"
      ],
      "properties": {
        "strict_status_checks": {"const": true},
        "enforce_admins": {"const": true},
        "required_approving_reviews": {"type": "integer", "minimum": 1, "maximum": 6},
        "dismiss_stale_reviews": {"const": true},
        "require_last_push_approval": {"const": true},
        "require_code_owner_reviews": {"type": "boolean"},
        "required_conversation_resolution": {"const": true},
        "allow_force_pushes": {"const": false},
        "allow_deletions": {"const": false},
        "required_linear_history": {"type": "boolean"},
        "bypass_actors": {"type": "array", "maxItems": 0}
      }
    },
    "issues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages", "protected_branches", "umbrella"],
      "properties": {
        "pages": {"const": 7},
        "protected_branches": {"const": 125},
        "umbrella": {"const": 6}
      }
    },
    "closure_rule": {"type": "string", "minLength": 40}
  }
}
