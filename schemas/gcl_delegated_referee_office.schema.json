{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/gcl_delegated_referee_office.schema.json",
  "title": "GCL Standing Delegated Referee Office",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "designation_id",
    "title",
    "status",
    "effective",
    "designated_by",
    "designation_authority",
    "designated_at",
    "term",
    "expires_at",
    "office_identity",
    "agent_class",
    "appointment_method",
    "jurisdiction",
    "operating_rules",
    "independence_model",
    "revocation",
    "activation",
    "claim_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "designation_id": {"const": "GCL-DELEGATED-REFEREE-001"},
    "title": {"type": "string", "minLength": 1},
    "status": {"const": "CANDIDATE_PENDING_PROTECTED_MERGE"},
    "effective": {"const": false},
    "designated_by": {"const": "fyremael"},
    "designation_authority": {"const": "Human Steward"},
    "designated_at": {"type": "string", "format": "date-time"},
    "term": {"const": "UNTIL_REVOKED"},
    "expires_at": {"type": "null"},
    "office_identity": {"const": "GCL Delegated Referee Office"},
    "agent_class": {"type": "string", "minLength": 1},
    "appointment_method": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "operating_rules": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {"const": true}
    },
    "independence_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institutional_independence", "required_disclosure", "automatic_disqualification"],
      "properties": {
        "institutional_independence": {"const": "ROLE_SEPARATION"},
        "required_disclosure": {"type": "string", "minLength": 1},
        "automatic_disqualification": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "immediate_fail_closed_on_revocation", "prior_reviews_remain_historical_evidence"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "immediate_fail_closed_on_revocation": {"const": true},
        "prior_reviews_remain_historical_evidence": {"const": true}
      }
    },
    "activation": {"const": "PROTECTED_MERGE_ONLY"},
    "claim_boundaries": {"type": "object", "minProperties": 8, "additionalProperties": {"const": false}}
  }
}
