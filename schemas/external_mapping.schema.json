{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned external classification mappings",
  "type": "object",
  "required": ["mapping_set_id", "mapping_set_version", "domain_id", "mappings"],
  "properties": {
    "mapping_set_id": {
      "type": "string",
      "minLength": 1
    },
    "mapping_set_version": {
      "type": "string",
      "minLength": 1
    },
    "domain_id": {
      "type": "string",
      "minLength": 1
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mapping_id",
          "internal_ref",
          "scheme",
          "scheme_version",
          "identifier",
          "mapping_relation",
          "role",
          "provenance",
          "confidence",
          "review_status"
        ],
        "properties": {
          "mapping_id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"
          },
          "internal_ref": {
            "type": "string",
            "minLength": 1
          },
          "scheme": {
            "enum": ["MSC", "ARXIV", "OPENALEX", "ONTOMATHPRO"]
          },
          "scheme_version": {
            "type": "string",
            "minLength": 1
          },
          "identifier": {
            "type": "string",
            "minLength": 1
          },
          "mapping_relation": {
            "enum": ["EXACT", "CLOSE", "BROAD", "NARROW", "RELATED"]
          },
          "role": {
            "enum": ["PRIMARY", "SECONDARY", "FACET"]
          },
          "provenance": {
            "type": "object",
            "required": ["source_id", "assigned_by", "assigned_at", "evidence"],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "assigned_by": {
                "type": "string",
                "minLength": 1
              },
              "assigned_at": {
                "type": "string",
                "format": "date"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "review_status": {
            "enum": ["PROPOSED", "AUDITED", "REJECTED", "SUPERSEDED"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
