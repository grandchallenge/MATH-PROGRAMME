{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned external classification mappings",
  "type": "object",
  "required": ["mapping_set_id", "mapping_set_version", "mapping_set_status", "domain_id", "mappings"],
  "properties": {
    "mapping_set_id": {
      "type": "string",
      "minLength": 1
    },
    "mapping_set_version": {
      "type": "string",
      "minLength": 1
    },
    "domain_id": {
      "type": "string",
      "minLength": 1
    },
    "mapping_set_status": {
      "enum": ["CANDIDATE", "QUALIFIED", "RETIRED"]
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mapping_id",
          "target_type",
          "internal_ref",
          "scheme",
          "scheme_version",
          "identifier",
          "label",
          "mapping_relation",
          "role",
          "provenance",
          "confidence",
          "review_status"
        ],
        "properties": {
          "mapping_id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"
          },
          "internal_ref": {
            "type": "string",
            "minLength": 1
          },
          "target_type": {
            "enum": ["DOMAIN", "GRAPH_NODE"]
          },
          "scheme": {
            "enum": ["MSC", "ARXIV", "OPENALEX", "ONTOMATHPRO", "ACM_CCS", "PHYSH", "WIKIDATA", "OPENMATH"]
          },
          "scheme_version": {
            "type": "string",
            "minLength": 1
          },
          "identifier": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "mapping_relation": {
            "enum": ["EXACT", "CLOSE", "BROAD", "NARROW", "RELATED"]
          },
          "role": {
            "enum": ["PRIMARY_SUBJECT", "SECONDARY_SUBJECT", "DISCOVERY_FACET", "DOMAIN_FACET", "CONCEPT_CROSSWALK"]
          },
          "provenance": {
            "type": "object",
            "required": ["source_id", "source_artifact_id", "assignment_method", "assigned_by", "assigned_at", "evidence"],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "source_artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "assignment_method": {
                "enum": ["HUMAN_CURATED", "PROVIDER_AUTOMATED", "IMPORTED_EXISTING"]
              },
              "assigned_by": {
                "type": "string",
                "minLength": 1
              },
              "assigned_at": {
                "type": "string",
                "format": "date"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "review_status": {
            "enum": ["PROPOSED", "AUDITED", "REJECTED", "SUPERSEDED"]
          },
          "reviewed_by": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "review_ref": {
            "type": "string",
            "minLength": 1
          },
          "supersedes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "superseded_by": {
            "type": ["string", "null"],
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"review_status": {"const": "AUDITED"}}},
            "then": {"required": ["reviewed_by", "reviewed_at", "review_ref"]}
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
