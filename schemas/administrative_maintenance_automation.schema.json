{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/administrative_maintenance_automation.schema.json",
  "title": "Administrative Maintenance Automation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "automation_id", "control_id", "repository", "evidence_repositories", "procedures", "bootstrap_receipts", "preparation_crons_utc", "hourly_refresh_cron_utc", "mirrors", "workflow_permissions", "credential_contract", "authority_boundary", "claim_boundaries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "automation_id": {"const": "MP-ADMIN-AUTOMATION-CLOSURE-001"},
    "control_id": {"const": "MP-ADMIN-MAINT-001"},
    "repository": {"const": "grandchallenge/MATH-PROGRAMME"},
    "evidence_repositories": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}},
    "procedures": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lead_minutes", "freeze_minutes", "record_globs", "due_fields", "receipt_floor_utc"],
        "properties": {
          "lead_minutes": {"type": "integer", "minimum": 1},
          "freeze_minutes": {"type": "integer", "minimum": 1},
          "record_globs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "due_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "receipt_floor_utc": {"type": "string", "format": "date-time"}
        }
      }
    },
    "bootstrap_receipts": {"type": "array", "items": {"$ref": "#/$defs/receipt"}},
    "preparation_crons_utc": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "hourly_refresh_cron_utc": {"type": "string", "minLength": 1},
    "mirrors": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["repository", "issue"], "properties": {"repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "issue": {"type": "integer", "minimum": 1}}}},
    "workflow_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispatcher", "candidate_preparation", "completion_synchronization", "automation_validation"],
      "properties": {
        "dispatcher": {"$ref": "#/$defs/readOnlyPermissions"},
        "candidate_preparation": {"$ref": "#/$defs/readOnlyPermissions"},
        "completion_synchronization": {"$ref": "#/$defs/readOnlyPermissions"},
        "automation_validation": {"$ref": "#/$defs/readOnlyPermissions"}
      }
    },
    "credential_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "action", "app_id_secret", "private_key_secret", "candidate_write_scope", "candidate_evidence_scope", "synchronization_write_scope", "intellect_mirror_scope"],
      "properties": {
        "provider": {"const": "GCL Release Trust GitHub App"},
        "action": {"const": "actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1"},
        "app_id_secret": {"const": "GCL_RELEASE_TRUST_APP_ID"},
        "private_key_secret": {"const": "GCL_RELEASE_TRUST_PRIVATE_KEY"},
        "candidate_write_scope": {"$ref": "#/$defs/tokenScope"},
        "candidate_evidence_scope": {"$ref": "#/$defs/tokenScope"},
        "synchronization_write_scope": {"$ref": "#/$defs/tokenScope"},
        "intellect_mirror_scope": {"$ref": "#/$defs/tokenScope"}
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated_approval", "automated_human_steward_disposition", "automated_merge", "automated_auto_merge", "branch_protection_bypass"],
      "properties": {
        "automated_approval": {"const": false},
        "automated_human_steward_disposition": {"const": false},
        "automated_merge": {"const": false},
        "automated_auto_merge": {"const": false},
        "branch_protection_bypass": {"const": false}
      }
    },
    "claim_boundaries": {"type": "object", "minProperties": 1, "additionalProperties": {"const": false}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "readOnlyPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contents"],
      "properties": {"contents": {"const": "read"}}
    },
    "tokenScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "permissions"],
      "properties": {
        "repositories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}},
        "permissions": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["read", "write"]}}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["procedure_id", "scheduled_due_at", "record_path", "record_sha256", "merge_commit", "reviewed_head", "pull_request", "disposition", "receipt_state"],
      "properties": {
        "procedure_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "scheduled_due_at": {"type": "string", "format": "date-time"},
        "record_path": {"type": "string", "minLength": 1},
        "record_sha256": {"type": "string", "minLength": 40},
        "merge_commit": {"$ref": "#/$defs/sha"},
        "reviewed_head": {"$ref": "#/$defs/sha"},
        "pull_request": {"type": "integer", "minimum": 1},
        "disposition": {"type": "string", "minLength": 1},
        "receipt_state": {"const": "PROTECTED_COMPLETE"}
      }
    }
  }
}
