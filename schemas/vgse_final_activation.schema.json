{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/vgse_final_activation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "campaign_id",
    "tracker_issue",
    "disposition",
    "programme_authority",
    "solve_authority",
    "cert_authority",
    "programme_effect",
    "consumer_obligation",
    "claim_boundary",
    "reopening_conditions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "const": "MP-VGSE-FINAL-ACTIVATION-001"
    },
    "campaign_id": {
      "const": "VGSE-001"
    },
    "tracker_issue": {
      "const": "https://github.com/grandchallenge/MATH-PROGRAMME/issues/170"
    },
    "disposition": {
      "const": "ACTIVATE_BOUNDED_PENDING_INTELLECT_REPIN"
    },
    "programme_authority": {
      "type": "object"
    },
    "solve_authority": {
      "type": "object"
    },
    "cert_authority": {
      "type": "object"
    },
    "programme_effect": {
      "type": "object"
    },
    "consumer_obligation": {
      "type": "object"
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": {
        "const": false
      },
      "minProperties": 8
    },
    "reopening_conditions": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  }
}
