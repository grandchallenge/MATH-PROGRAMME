{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Pedagogy Propagation Stage-0 Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","docket","parent_issue","implementation_issue","status","stage0_base_sha","audit_source","authority","counts","batch_counts","risk_model","batches","asset_record_fields","migration_record_fields","assets","migration"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "docket": {"const": "MP-DOC-VISUAL-PROPAGATION-STAGE0-001"},
    "parent_issue": {"const": 416},
    "implementation_issue": {"const": 417},
    "status": {"const": "AUTHORIZED_FOR_STAGE0_MANIFEST_CONSTRUCTION__NO_LIVE_VISUAL_SWITCH_AUTHORITY"},
    "stage0_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "audit_source": {"type": "object", "required": ["path","blob_sha","baseline_main_sha"]},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live_switch","blanket_rewrite","visual_is_evidence","per_batch_hs_exact_head"],
      "properties": {
        "live_switch": {"const": false},
        "blanket_rewrite": {"const": false},
        "visual_is_evidence": {"const": false},
        "per_batch_hs_exact_head": {"const": true}
      }
    },
    "counts": {"type": "object", "required": ["assets","KEEP","REDRAW","REPLACE","migration"]},
    "batch_counts": {"type": "object", "required": ["1","2","3","4","5"]},
    "risk_model": {"type": "object"},
    "batches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1","2","3","4","5"],
      "properties": {
        "1": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "2": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "3": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "4": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "5": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "asset_record_fields": {"const": ["blob","disposition","visual_is_evidence"]},
    "migration_record_fields": {"const": ["batch","rollback_blob","successor_class","renderer_provenance_route","review_mode","isolated_pr","fanout","risk_tuple"]},
    "assets": {
      "type": "object",
      "minProperties": 45,
      "maxProperties": 45,
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          {"enum": ["KEEP","REDRAW","REPLACE"]},
          {"const": false}
        ],
        "minItems": 3,
        "maxItems": 3
      }
    },
    "migration": {
      "type": "object",
      "minProperties": 26,
      "maxProperties": 26,
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          {"type": "integer", "minimum": 1, "maximum": 5},
          {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          {"type": "string"},
          {"type": "string"},
          {"type": "string"},
          {"type": "boolean"},
          {"type": "integer", "minimum": 1},
          {"type": "array", "minItems": 8, "maxItems": 8}
        ],
        "minItems": 8,
        "maxItems": 8
      }
    }
  }
}
