          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclusions": {
          "const": [
            "ordinary_forward_computation",
            "theorem_proving_without_reconstruction_claim",
            "numerical_evaluation_without_latent_recovery",
            "exploratory_work_without_representative_recovery_claim"
          ]
        },
        "grandfathering": {
          "const": "No retrospective rewrite is required. Existing work enters scope only at a new material inverse/reconstruction tranche or when it makes a new recovery claim."
        }
