      "properties": {
        "trigger": {
          "const": "A work package makes, tests, or materially depends on a claim that hidden state, parameters, calibration, representation, geometry, or other latent structure can be reconstructed from declared observations."
        },
        "trigger_examples": {
          "type": "array",
