{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/administrative_structural_sweep_v2.schema.json",
  "title": "Administrative Structural Sweep v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sweep_id",
    "control_id",
    "decision_id",
    "status",
    "scheduled_due_at",
    "execution_started_at",
    "evidence_closed_at",
    "evidence_mode",
    "lateness_minutes_at_start",
    "cadence",
    "next_structural_due_at",
    "administrative_review_due_at",
    "pilot_review_due_at",
    "execution_authority",
    "baseline_reset",
    "scope",
    "tracker_mirrors",
    "checks",
    "findings",
    "repair_actions",
    "review_readiness",
    "claim_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "sweep_id": {"type": "string", "pattern": "^MP-ADMIN-STRUCTURAL-SWEEP-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
    "control_id": {"const": "MP-ADMIN-MAINT-001"},
    "decision_id": {"const": "MP-ADMIN-DECISION-001"},
    "status": {"enum": ["COMPLETE", "COMPLETE_WITH_REPAIRED_P2", "COMPLETE_WITH_REPAIRED_P2_AND_NONBLOCKING_OPEN_PR"]},
    "scheduled_due_at": {"type": "string", "format": "date-time"},
    "execution_started_at": {"type": "string", "format": "date-time"},
    "evidence_closed_at": {"type": "string", "format": "date-time"},
    "evidence_mode": {"enum": ["CONTEMPORANEOUS", "RETROSPECTIVE_RECONSTRUCTION"]},
    "lateness_minutes_at_start": {"type": "integer", "minimum": 0},
    "cadence": {"const": "PT16H48M"},
    "next_structural_due_at": {"type": "string", "format": "date-time"},
    "administrative_review_due_at": {"type": "string", "format": "date-time"},
    "pilot_review_due_at": {"type": "string", "format": "date-time"},
    "execution_authority": {"type": "string", "minLength": 1},
    "baseline_reset": {"$ref": "#/$defs/baselineReset"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "open_pull_requests"],
      "properties": {
        "repositories": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/repositorySweep"}},
        "open_pull_requests": {"type": "array", "items": {"$ref": "#/$defs/openPullRequest"}}
      }
    },
    "tracker_mirrors": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/trackerMirror"}},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected_heads", "open_pr_interference", "schema_and_current_state_parseability", "required_workflow_presence", "canonical_tracker_links_and_freshness", "issue_authority_language", "expired_review_evidence", "missing_canonical_records", "duplicate_canonical_records"],
      "properties": {
        "protected_heads": {"type": "string", "pattern": "^PASS"},
        "open_pr_interference": {"type": "string", "pattern": "^PASS"},
        "schema_and_current_state_parseability": {"type": "string", "pattern": "^PASS"},
        "required_workflow_presence": {"type": "string", "pattern": "^PASS"},
        "canonical_tracker_links_and_freshness": {"type": "string", "pattern": "^PASS"},
        "issue_authority_language": {"type": "string", "pattern": "^PASS"},
        "expired_review_evidence": {"type": "string", "pattern": "^PASS"},
        "missing_canonical_records": {"type": "string", "pattern": "^PASS"},
        "duplicate_canonical_records": {"type": "string", "pattern": "^PASS"}
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P0", "P1", "P2", "P3"],
      "properties": {
        "P0": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "P1": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "P2": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "P3": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "repair_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "status"],
        "properties": {
          "action": {"type": "string", "minLength": 1},
          "status": {"enum": ["COMPLETE", "COMPLETE_ON_REVIEW_BRANCH"]}
        }
      }
    },
    "review_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected_review_clear_to_proceed", "reason", "circuit_breaker_triggered", "waiver_used", "emergency_authority_used", "pending_manual_processes_at_evidence_freeze", "independent_exact_head_review_required", "human_steward_exact_head_disposition_required"],
      "properties": {
        "protected_review_clear_to_proceed": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "circuit_breaker_triggered": {"type": "boolean"},
        "waiver_used": {"type": "boolean"},
        "emergency_authority_used": {"type": "boolean"},
        "pending_manual_processes_at_evidence_freeze": {"type": "integer", "minimum": 0},
        "independent_exact_head_review_required": {"type": "boolean"},
        "human_steward_exact_head_disposition_required": {"type": "boolean"}
      }
    },
    "claim_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mathematical_target_proved", "interface_qualification_promoted_to_theorem", "campaign_admitted", "source_verified", "cert_route_registered", "adjudication_authorized", "certificate_issued", "novelty_claim_authorized", "priority_claim_authorized", "publication_claim_authorized", "patentability_claim_authorized", "product_claim_authorized", "commercial_claim_authorized"],
      "properties": {
        "mathematical_target_proved": {"const": false},
        "interface_qualification_promoted_to_theorem": {"const": false},
        "campaign_admitted": {"const": false},
        "source_verified": {"const": false},
        "cert_route_registered": {"const": false},
        "adjudication_authorized": {"const": false},
        "certificate_issued": {"const": false},
        "novelty_claim_authorized": {"const": false},
        "priority_claim_authorized": {"const": false},
        "publication_claim_authorized": {"const": false},
        "patentability_claim_authorized": {"const": false},
        "product_claim_authorized": {"const": false},
        "commercial_claim_authorized": {"const": false}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nullableInteger": {"type": ["integer", "null"], "minimum": 1},
    "nullableString": {"type": ["string", "null"]},
    "nullableBoolean": {"type": ["boolean", "null"]},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "run_id", "conclusion"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "run_id": {"type": "integer", "minimum": 1},
        "conclusion": {"const": "success"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "review_id", "state", "exact_head"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "review_id": {"type": "integer", "minimum": 1},
        "state": {"const": "APPROVED"},
        "exact_head": {"const": true}
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "comment_id", "actor", "exact_head"],
      "properties": {
        "required": {"type": "boolean"},
        "comment_id": {"$ref": "#/$defs/nullableInteger"},
        "actor": {"$ref": "#/$defs/nullableString"},
        "exact_head": {"$ref": "#/$defs/nullableBoolean"}
      }
    },
    "baselineReset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_authorized_head", "reset_protected_head", "reset_transition_pr", "reset_transition_reviewed_head", "implementation_branch", "branch_ahead_before_reset", "branch_behind_before_reset", "implementation_commits_discarded", "pending_manual_processes_at_reset", "cadence_anchor_reset"],
      "properties": {
        "original_authorized_head": {"$ref": "#/$defs/sha"},
        "reset_protected_head": {"$ref": "#/$defs/sha"},
        "reset_transition_pr": {"type": "integer", "minimum": 1},
        "reset_transition_reviewed_head": {"$ref": "#/$defs/sha"},
        "implementation_branch": {"type": "string", "minLength": 1},
        "branch_ahead_before_reset": {"type": "integer", "minimum": 0},
        "branch_behind_before_reset": {"type": "integer", "minimum": 0},
        "implementation_commits_discarded": {"type": "integer", "minimum": 0},
        "pending_manual_processes_at_reset": {"type": "integer", "minimum": 0},
        "cadence_anchor_reset": {"type": "boolean"}
      }
    },
    "repositorySweep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "protected_head", "reviewed_head", "latest_transition_pr", "merge_commit", "tracker_issue", "review", "disposition", "core_workflow", "gcl_workflow", "material_transition"],
      "properties": {
        "repository": {"enum": ["grandchallenge/MATH-PROGRAMME", "grandchallenge/MATHFORGE", "grandchallenge/MATHSOLVE", "grandchallenge/MATHCERT", "grandchallenge/INTELLECT"]},
        "protected_head": {"$ref": "#/$defs/sha"},
        "reviewed_head": {"$ref": "#/$defs/sha"},
        "latest_transition_pr": {"type": "integer", "minimum": 1},
        "merge_commit": {"$ref": "#/$defs/sha"},
        "tracker_issue": {"type": "integer", "minimum": 1},
        "review": {"$ref": "#/$defs/review"},
        "disposition": {"$ref": "#/$defs/disposition"},
        "core_workflow": {"$ref": "#/$defs/workflow"},
        "gcl_workflow": {"$ref": "#/$defs/workflow"},
        "material_transition": {"type": "string", "minLength": 1}
      }
    },
    "openPullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pull_request", "author", "head", "base", "draft", "merge_authorized", "core_run_id", "gcl_run_id", "interference_disposition"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "pull_request": {"type": "integer", "minimum": 1},
        "author": {"type": "string", "minLength": 1},
        "head": {"$ref": "#/$defs/sha"},
        "base": {"$ref": "#/$defs/sha"},
        "draft": {"type": "boolean"},
        "merge_authorized": {"type": "boolean"},
        "core_run_id": {"type": "integer", "minimum": 1},
        "gcl_run_id": {"type": "integer", "minimum": 1},
        "interference_disposition": {"type": "string", "minLength": 1}
      }
    },
    "trackerMirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "issue", "state_at_freeze", "repair_required", "repair_completed"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "issue": {"type": "integer", "minimum": 1},
        "state_at_freeze": {"type": "string", "minLength": 1},
        "repair_required": {"type": "boolean"},
        "repair_completed": {"type": "boolean"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "title", "observed_at", "disposition"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^MP-ADMIN-P[0-3]-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "disposition": {"type": "string", "minLength": 1},
        "repair_reference": {"type": "string", "minLength": 1}
      }
    }
  }
}
