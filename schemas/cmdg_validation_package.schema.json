{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/cmdg_validation_package.schema.json",
  "title": "CMDG runtime validation package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_schema_version",
    "package_id",
    "manifest_path",
    "manifest_git_blob_sha1",
    "required_schema_versions",
    "nodes",
    "additional_edges",
    "retained_evidence",
    "requested_terminal_state",
    "claim_boundary"
  ],
  "properties": {
    "package_schema_version": {"const": "1.0.0"},
    "package_id": {"type": "string", "pattern": "^CMDG-PACKAGE-[A-Z0-9][A-Z0-9._-]*$"},
    "manifest_path": {"type": "string", "minLength": 1},
    "manifest_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "required_schema_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "edge", "manifest", "package", "report"],
      "properties": {
        "node": {"const": "1.0.0"},
        "edge": {"const": "1.0.0"},
        "manifest": {"const": "1.0.0"},
        "package": {"const": "1.0.0"},
        "report": {"const": "1.0.0"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://grandchallenge.ai/schemas/cmdg_node.schema.json"}
    },
    "additional_edges": {
      "type": "array",
      "items": {"$ref": "https://grandchallenge.ai/schemas/cmdg_edge.schema.json"}
    },
    "retained_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_environment", "replay", "implementation_pins"],
      "properties": {
        "proof_environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["environment_id", "prover", "toolchain", "pins", "clean_replay_command"],
          "properties": {
            "environment_id": {"type": "string", "minLength": 1},
            "prover": {"type": "string", "minLength": 1},
            "toolchain": {"type": "string", "minLength": 1},
            "pins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "clean_replay_command": {"type": "string", "minLength": 1}
          }
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route_id", "exact_environment_ref", "command", "artifact_refs"],
          "properties": {
            "route_id": {"type": "string", "minLength": 1},
            "exact_environment_ref": {"type": "string", "minLength": 1},
            "command": {"type": "string", "minLength": 1},
            "artifact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "implementation_pins": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "requested_terminal_state": {"const": "VALIDATOR_ACCEPTED_PRECONDITIONS"},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_certified_conferred", "global_completeness_claim"],
      "properties": {
        "graph_certified_conferred": {"const": false},
        "global_completeness_claim": {"const": false}
      }
    }
  }
}
