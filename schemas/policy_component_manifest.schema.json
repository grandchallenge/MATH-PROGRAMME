{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MATH-PROGRAMME declarative CI component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component_id",
    "owner",
    "shards",
    "depends_on",
    "paths"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "component_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact",
        "prefixes",
        "test_prefixes"
      ],
      "properties": {
        "exact": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "test_prefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    }
  }
}
