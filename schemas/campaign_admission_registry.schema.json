{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/campaign_admission_registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "verified_at",
    "authority",
    "active_campaign_registry",
    "lifecycle_states",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3.0"
    },
    "registry_id": {
      "const": "MP-CAMPAIGN-ADMISSION-001"
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "state_authority",
        "github_issue_role",
        "candidate_issue_mutation_can_admit_campaign",
        "candidate_work_can_modify_active_portfolio"
      ],
      "properties": {
        "repository": {
          "const": "grandchallenge/MATH-PROGRAMME"
        },
        "state_authority": {
          "const": "protected_branch_repository_records"
        },
        "github_issue_role": {
          "const": "mutable_navigational_mirror"
        },
        "candidate_issue_mutation_can_admit_campaign": {
          "const": false
        },
        "candidate_work_can_modify_active_portfolio": {
          "const": false
        }
      }
    },
    "active_campaign_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest_algorithm",
        "digest",
        "active_routing_member_count",
        "archived_member_count"
      ],
      "properties": {
        "path": {
          "const": "governance/governed_campaign_registry.json"
        },
        "digest_algorithm": {
          "const": "git_blob_sha1"
        },
        "digest": {
          "pattern": "^[0-9a-f]{40}$"
        },
        "active_routing_member_count": {
          "const": 9
        },
        "archived_member_count": {
          "const": 1
        }
      }
    },
    "lifecycle_states": {
      "const": [
        "candidate",
        "admitted_active",
        "rejected",
        "withdrawn"
      ]
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "candidate_phase",
        "lifecycle_state",
        "programme_tracker_issue",
        "governance_issue",
        "governance_history",
        "active_portfolio_member",
        "source_provenance",
        "solve_candidate",
        "certification_candidate",
        "programme_decision",
        "admission_gates",
        "claim_boundary"
      ],
      "properties": {
        "campaign_id": {
          "enum": [
            "NSOF-001",
            "VGSE-001"
          ]
        },
        "candidate_phase": {
          "enum": [
            "intake_only",
            "activated_bounded_pending_cert_evidence"
          ]
        },
        "lifecycle_state": {
          "enum": [
            "candidate",
            "admitted_active"
          ]
        },
        "programme_tracker_issue": {
          "type": "integer",
          "minimum": 1
        },
        "governance_issue": {
          "type": "integer",
          "minimum": 1
        },
        "governance_history": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "active_portfolio_member": {
          "type": "boolean"
        },
        "source_provenance": {
          "type": "object"
        },
        "solve_candidate": {
          "type": "object"
        },
        "certification_candidate": {
          "type": "object"
        },
        "programme_decision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "admission_gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "forge_provider_manifest_admitted",
            "source_revision_concordance_complete",
            "solve_candidate_package_reviewed",
            "cert_route_registered",
            "programme_active_registry_updated",
            "programme_routing_registry_updated",
            "runtime_contract_updated_for_active_admission",
            "intellect_repin_complete_if_required"
          ],
          "properties": {
            "forge_provider_manifest_admitted": {
              "type": "boolean"
            },
            "source_revision_concordance_complete": {
              "type": "boolean"
            },
            "solve_candidate_package_reviewed": {
              "type": "boolean"
            },
            "cert_route_registered": {
              "type": "boolean"
            },
            "programme_active_registry_updated": {
              "type": "boolean"
            },
            "programme_routing_registry_updated": {
              "type": "boolean"
            },
            "runtime_contract_updated_for_active_admission": {
              "type": "boolean"
            },
            "intellect_repin_complete_if_required": {
              "type": "boolean"
            }
          }
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 50
        }
      }
    }
  }
}
