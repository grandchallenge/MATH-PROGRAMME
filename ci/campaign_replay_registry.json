{
  "$schema": "../schemas/campaign_replay_registry.schema.json",
  "schema_version": "2.0.0",
  "entries": [
    {
      "id": "SYMBOLIC-RESOURCE-BUDGET-VALIDATION",
      "command": ["python3", "ci/validate_symbolic_resource_budgets.py"],
      "timeout_seconds": 60,
      "scope": "Discover every marked expensive symbolic lane and fail closed on missing registration, budgets, execution state, or preserved failure evidence."
    },
    {
      "id": "SYMBOLIC-RESOURCE-BUDGET-ADVERSARIAL",
      "command": ["python3", "tests/test_symbolic_resource_budgets.py"],
      "timeout_seconds": 60,
      "scope": "Reject omitted budgets, unregistered lanes, orphan registry records, suppressed failures, and completed runs without result artifacts."
    },
    {
      "id": "MATHFORGE-PROVIDER-IMPORT-VALIDATION",
      "command": ["python3", "ci/validate_mathforge_provider_imports.py"],
      "timeout_seconds": 60,
      "scope": "Fail closed on missing active-domain provider coverage, provider commit drift, manifest identity drift, or malformed waivers."
    },
    {
      "id": "MATHSOLVE-ROUTING-VALIDATION",
      "command": ["python3", "ci/validate_mathsolve_routing.py"],
      "timeout_seconds": 60,
      "scope": "Fail closed on missing Solve routes, provider or manifest drift, Programme-embedded future promotion, and missing MATHCERT handoffs."
    },
    {
      "id": "BSD-WP01-REPLAY",
      "command": ["python3", "campaigns/birch_swinnerton_dyer/WP01_FALSE_PROOF_ATLAS/replay.py"],
      "timeout_seconds": 60,
      "scope": "Deterministic replay of the BSD false-proof atlas."
    },
    {
      "id": "BSD-WP01-WP02-CROSS-VALIDATION",
      "command": ["python3", "campaigns/birch_swinnerton_dyer/validate_wp01_wp02.py"],
      "timeout_seconds": 60,
      "scope": "Cross-validate BSD fixtures, sources, theorem interfaces, and closed gates."
    },
    {
      "id": "BSD-WP01-WP02-ADVERSARIAL",
      "command": ["python3", "campaigns/birch_swinnerton_dyer/test_validate_wp01_wp02.py"],
      "timeout_seconds": 60,
      "scope": "Reject BSD theorem-interface, dependency-debt, and gate-opening mutations."
    },
    {
      "id": "BSD-WP03-SUBSTRATE-REPLAY",
      "command": ["python3", "campaigns/birch_swinnerton_dyer/WP03_COMPUTATIONAL_FORMAL_SUBSTRATE/replay.py"],
      "timeout_seconds": 60,
      "scope": "Replay BSD computational and formal substrate firewalls."
    },
    {
      "id": "BSD-WP04-TARGET-REPLAY",
      "command": ["python3", "campaigns/birch_swinnerton_dyer/WP04_RESTRICTED_TARGET_SCORECARD/replay.py"],
      "timeout_seconds": 60,
      "scope": "Replay BSD restricted-target scorecard and claim firewall."
    },
    {
      "id": "OZ-WP00-INTAKE-VALIDATION",
      "command": [
        "python3",
        "campaigns/odd_zeta/OZ_WP00_SOURCE_NORMALIZATION_EQUIVALENCE/tools/validate_intake_manifest.py",
        "campaigns/odd_zeta/OZ_WP00_SOURCE_NORMALIZATION_EQUIVALENCE/01_INTAKE_SOURCE_LOCK.yaml"
      ],
      "timeout_seconds": 60,
      "scope": "Validate the open OZ-WP00 intake manifest without promoting incomplete source locks."
    },
    {
      "id": "PNP-WP01-REPLAY",
      "command": ["python3", "campaigns/p_vs_np/WP01_FALSE_PROOF_ATLAS/replay.py"],
      "timeout_seconds": 60,
      "scope": "Deterministic replay of the P-versus-NP false-proof atlas."
    },
    {
      "id": "PNP-WP01-WP02-CROSS-VALIDATION",
      "command": ["python3", "campaigns/p_vs_np/validate_wp01_wp02.py"],
      "timeout_seconds": 60,
      "scope": "Cross-validate P-versus-NP fixtures, sources, theorem interfaces, frontier debt, and closed gates."
    },
    {
      "id": "PNP-WP01-WP02-ADVERSARIAL",
      "command": ["python3", "campaigns/p_vs_np/tests/test_validate_wp01_wp02.py"],
      "timeout_seconds": 60,
      "scope": "Reject P-versus-NP identifier, source, terminal-state, barrier, frontier-debt, and gate-opening mutations."
    },
    {
      "id": "RH-WP01-REPLAY",
      "command": ["python3", "campaigns/riemann_hypothesis/WP01_FALSE_PROOF_ATLAS/replay.py"],
      "timeout_seconds": 60,
      "scope": "Deterministic replay of the RH false-proof atlas."
    },
    {
      "id": "RH-WP01-WP02-CROSS-VALIDATION",
      "command": ["python3", "campaigns/riemann_hypothesis/validate_wp01_wp02.py"],
      "timeout_seconds": 60,
      "scope": "Cross-validate RH fixtures, sources, theorem interfaces, debt, and closed gates."
    },
    {
      "id": "YM-WP01-REPLAY",
      "command": ["python3", "campaigns/yang_mills/WP01_FALSE_PROOF_ATLAS/replay.py"],
      "timeout_seconds": 60,
      "scope": "Deterministic replay of the Yang-Mills false-proof atlas."
    },
    {
      "id": "YM-WP01-WP02-CROSS-VALIDATION",
      "command": ["python3", "campaigns/yang_mills/validate_wp01_wp02.py"],
      "timeout_seconds": 60,
      "scope": "Cross-validate Yang-Mills fixtures, sources, theorem interfaces, dependency debt, unverified claims, and closed gates."
    },
    {
      "id": "YM-WP01-WP02-ADVERSARIAL",
      "command": ["python3", "campaigns/yang_mills/test_validate_wp01_wp02.py"],
      "timeout_seconds": 60,
      "scope": "Reject Yang-Mills source, interface, audit-state, status, debt, and gate-opening mutations."
    },
    {
      "id": "PC-WP03-HISTORY-REPLAY",
      "command": ["python3", "campaigns/poincare_reconstruction/WP03_SURGERY_TOPOLOGY/05_ADVERSARIAL_HISTORIES/validate_histories.py"],
      "timeout_seconds": 60,
      "scope": "Replay all valid and malformed Poincare surgery histories."
    },
    {
      "id": "PC-WP04-POLICY",
      "command": ["python3", "ci/validate_pc_wp04_fixture.py", "fixtures/formal/PC-WP04"],
      "timeout_seconds": 60,
      "scope": "Validate the bounded PC-WP04 certificate policy."
    },
    {
      "id": "PC-WP04-ADVERSARIAL",
      "command": ["python3", "ci/test_pc_wp04_fixture.py"],
      "timeout_seconds": 60,
      "scope": "Reject PC-WP04 certificate-policy mutations."
    },
    {
      "id": "PC-WP05-ARCHIVE-POLICY",
      "command": ["python3", "ci/validate_pc_wp05_archive.py"],
      "timeout_seconds": 60,
      "scope": "Validate the qualified Poincare archival manifest and trust matrix."
    },
    {
      "id": "PC-WP05-ADVERSARIAL",
      "command": ["python3", "ci/test_pc_wp05_archive.py"],
      "timeout_seconds": 60,
      "scope": "Reject PC-WP05 archival-policy mutations."
    }
  ],
  "exemptions": []
}
