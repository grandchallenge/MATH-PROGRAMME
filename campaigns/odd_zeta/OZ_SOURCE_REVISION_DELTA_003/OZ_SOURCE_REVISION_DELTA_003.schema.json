{
  "$id": "https://grandchallenge.ai/schemas/oz-source-revision-delta-003.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OZ-SOURCE-REVISION-DELTA-003",
  "type": "object",
