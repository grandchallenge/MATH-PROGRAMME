    },
    "execution_state": {"enum": ["STATIC_AUDIT_COMPLETE_PENDING_INDEPENDENT_REPLAY","REVIEW_READY","CLOSED"]},
    "candidate_disposition": {"enum": ["SOURCE_REVISION_ADMITTED_NO_PROMOTION","SOURCE_REVISION_PARTIALLY_ADMITTED_WITH_BLOCKERS","SOURCE_REVISION_REJECTED_IDENTITY_OR_REPLAY_FAILURE"]},
    "promotion_effect": {"const": "NONE"},
