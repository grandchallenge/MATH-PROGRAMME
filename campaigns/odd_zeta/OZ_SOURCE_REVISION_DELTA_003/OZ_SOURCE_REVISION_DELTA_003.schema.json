        "upstream_repository": {"const": "rain-1/-odd-zeta-values-moremath"},
        "governed_source_head": {"const": "790685b7ee4f642a8a88a1bd120636d1b8b39ea8"},
        "governed_source_tree": {"const": "646ee73dd9066e059b043fad64fb20959f111cbf"},
        "candidate_source_head": {"const": "6cc0bf07137815ceeef0d9f340559f85352391e5"},
        "candidate_tree": {"const": "be780558454b704bdd016a3070d698c2e106e2b8"},
        "ahead_by": {"const": 20},
        "changed_file_count": {"const": 44},
        "sharp12_path": {"const": "papers_out/sharp12/sharp12.tex"},
