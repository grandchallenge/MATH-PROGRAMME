      "source_tree": {"const": "646ee73dd9066e059b043fad64fb20959f111cbf"},
      "sharp12_path": {"const": "papers_out/sharp12/sharp12.tex"},
      "sharp12_blob": {"const": "6a347e2a483ec781afac98016635ce1d73b3c38e"},
      "later_source_head_audited": {"const": "6cc0bf07137815ceeef0d9f340559f85352391e5"},
