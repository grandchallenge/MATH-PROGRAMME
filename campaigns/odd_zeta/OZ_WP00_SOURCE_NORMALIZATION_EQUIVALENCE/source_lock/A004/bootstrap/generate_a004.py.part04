# literature records from 37 converted files, bound to primary source bytes
lit=[]
llm_files=[p for p in sorted((R2/'llm').glob('*.md')) if p.name!='INDEX.md']
assert len(llm_files)==37, len(llm_files)
for i,p in enumerate(llm_files,1):
    text=p.read_text(encoding='utf-8',errors='replace')
    meta={}
    if text.startswith('---\n'):
        end=text.find('\n---\n',4)
        meta=yaml.safe_load(text[4:end]) or {}
    source=meta.get('source')
    if not source or source not in M2:
        raise SystemExit(f'missing primary source for {p.name}: {source}')
    title=meta.get('title',p.stem)
    authors=meta.get('authors',[])
    if isinstance(authors,str): authors=[authors]
    bib='; '.join([title, ', '.join(authors) if authors else 'authors not normalized', meta.get('published','')]).strip('; ')
    persistent=meta.get('arxiv_url') or (f"https://doi.org/{meta['doi']}" if meta.get('doi') else loc(REPO2,C2,source))
    desc=f"Primary literature source acquired from the River corpus: {title}. Conversion mode {meta.get('conversion','not recorded')}; primary bytes, not the derivative conversion, are content-addressed."
    r=common(f'OZ-LIT-B{i:03d}',desc,L2,loc(REPO2,C2,source),M2[source]['sha256'],'LITERATURE_DERIVED',scope='Source identification and byte lock only; theorem-level claim audit not yet completed.')
    r.update({'bibliographic_identity':bib,'persistent_locator':persistent,'audited_claims':[],'equivalence_findings':[]})
    lit.append(r)

