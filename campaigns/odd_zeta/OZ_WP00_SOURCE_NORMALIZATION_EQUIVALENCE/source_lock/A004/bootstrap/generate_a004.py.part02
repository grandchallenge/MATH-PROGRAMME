lean=[]
def lrec(id, repo, commit, lock, path, decl, desc, corr, sorry, axioms, build, math='FORMALIZED', scope='', assumptions=None):
    m=M1 if lock==L1 else M2
    r=common(id,desc,lock,loc(repo,commit,path),m[path]['sha256'],math,scope=scope,assumptions=assumptions or [],supports=[corr] if corr else [])
    r.update({'repository':repo,'commit':commit,'file':path,'declaration':decl,'imported_axioms':axioms,'sorry_free':sorry,'build_result':build,'semantic_correspondence_id':corr})
    return r
lean.append(lrec('OZ-L4-T001',REPO1,C1,L1,'zeta5odd/Zeta5Odd/Main.lean','Zeta5Odd.zeta_odd_irrational','Lean declaration of the zeta(5) through zeta(33) irrationality disjunction.','OZ-MSS-S001',True,['propext','Classical.choice','Quot.sound'],'SOURCE_REPORTED_GREEN; GCL independent replay pending.',scope='Unbounded theorem as declared.'))
