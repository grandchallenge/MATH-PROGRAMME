# compact durable file identity tables
for inv,name in [(INV1,'OZ-SRC-RIVER-FORMALIZATION-001.FILE_IDENTITIES.tsv'),(INV2,'OZ-SRC-RIVER-MOREMATH-001.FILE_IDENTITIES.tsv')]:
    lines=['entry_type\tgit_mode\tbytes\tsha256\tgit_object_sha1\tpath']
    for e in inv['files']:
        lines.append('\t'.join([str(e.get('entry_type','')),str(e.get('git_mode','')),'' if e.get('bytes') is None else str(e['bytes']),str(e.get('sha256') or ''),str(e.get('git_object_sha1','')),e['path']]))
    (OUT/name).write_text('\n'.join(lines)+'\n',encoding='utf-8',errors='surrogateescape')

