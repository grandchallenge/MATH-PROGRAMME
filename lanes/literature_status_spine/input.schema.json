{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["lane_id", "research_question", "cutoff_date", "source_requirements", "terminology_lock", "claim_taxonomy", "search_record"],
  "properties": {
    "lane_id": {"const": "LANE-LITERATURE-STATUS"},
    "research_question": {"type": "string", "minLength": 1},
    "cutoff_date": {"type": "string", "format": "date"},
    "source_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "terminology_lock": {"type": "object", "minProperties": 1},
    "claim_taxonomy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "search_record": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query", "source_class", "searched_at"],
        "properties": {
          "query": {"type": "string", "minLength": 1},
          "source_class": {"type": "string", "minLength": 1},
          "searched_at": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
