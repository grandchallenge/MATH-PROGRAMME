{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["lane_id", "status", "source_records", "status_spine", "unresolved_conflicts", "novelty_prohibition", "certification_state"],
  "properties": {
    "lane_id": {"const": "LANE-LITERATURE-STATUS"},
    "status": {"enum": ["search_locked", "sources_audited", "status_spine_ready", "ready_for_mathcert", "rejected"]},
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_type", "locator", "audited_claim"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["primary", "secondary"]},
          "locator": {"type": "string", "minLength": 1},
          "audited_claim": {"type": "string", "minLength": 1}
        }
      }
    },
    "status_spine": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "status", "summary", "source_refs"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["established", "open", "conditional", "disputed", "unresolved"]},
          "summary": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "unresolved_conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "novelty_prohibition": {"const": true},
    "certification_state": {"enum": ["not_certified", "ready_for_mathcert", "certified_by_mathcert"]}
  }
}
