{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["lane_id", "status", "enclosure", "enclosure_claim", "subdivision_count", "proof_artifact", "replay_command", "certification_state"],
  "properties": {
    "lane_id": {"const": "LANE-INTERVAL"},
    "status": {"enum": ["configured", "enclosed", "subdivision_required", "ready_for_mathcert", "rejected"]},
    "enclosure": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "enclosure_claim": {"type": "string", "minLength": 1},
    "subdivision_count": {"type": "integer", "minimum": 1},
    "proof_artifact": {"type": "string", "minLength": 1},
    "replay_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "certification_state": {"enum": ["not_certified", "ready_for_mathcert", "certified_by_mathcert"]}
  }
}
