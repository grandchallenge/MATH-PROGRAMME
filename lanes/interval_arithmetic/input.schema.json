{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["lane_id", "expression", "variables", "domain", "target_relation", "precision_bits", "rounding_mode", "backend", "backend_version"],
  "properties": {
    "lane_id": {"const": "LANE-INTERVAL"},
    "expression": {"type": "string", "minLength": 1},
    "variables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "domain": {"type": "object", "minProperties": 1},
    "target_relation": {"type": "string", "minLength": 1},
    "precision_bits": {"type": "integer", "minimum": 32},
    "rounding_mode": {"const": "outward"},
    "backend": {"type": "string", "minLength": 1},
    "backend_version": {"type": "string", "minLength": 1}
  }
}
