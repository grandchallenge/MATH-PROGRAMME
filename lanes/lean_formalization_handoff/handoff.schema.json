{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["lane_id", "status", "repository", "commit", "target_file", "theorem_name", "build_command", "dependency_lock", "no_sorry", "no_local_axiom", "source_correspondence", "certification_state"],
  "properties": {
    "lane_id": {"const": "LANE-LEAN-HANDOFF"},
    "status": {"enum": ["normalized", "formalization_ready", "build_passed", "ready_for_mathcert", "rejected"]},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_file": {"type": "string", "minLength": 1},
    "theorem_name": {"type": "string", "minLength": 1},
    "build_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependency_lock": {"type": "string", "minLength": 1},
    "no_sorry": {"const": true},
    "no_local_axiom": {"const": true},
    "source_correspondence": {"type": "string", "minLength": 1},
    "certification_state": {"enum": ["not_certified", "ready_for_mathcert", "certified_by_mathcert"]}
  }
}
