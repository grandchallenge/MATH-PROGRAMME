{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["lane_id", "normalized_statement", "assumptions", "source_refs", "imports", "target_file", "theorem_name", "trust_policy"],
  "properties": {
    "lane_id": {"const": "LANE-LEAN-HANDOFF"},
    "normalized_statement": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "imports": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "target_file": {"type": "string", "minLength": 1},
    "theorem_name": {"type": "string", "minLength": 1},
    "trust_policy": {"const": "no_sorry_no_local_axiom"}
  }
}
