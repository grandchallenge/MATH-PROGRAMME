{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/gcl-tcs-conformance-0.1.0.schema.json",
  "title": "GCL Technical Communication Conformance Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "standard", "artifact_id", "title", "artifact_type", "version", "date", "owner", "authority_status", "promotion_status", "primary_profile", "secondary_profiles", "impact_class", "audience", "scope", "out_of_scope", "source_location", "source_revision", "dependencies", "terminology_registry", "notation_registry", "claim_register", "evidence_register", "review_register", "exceptions", "conformance_dimensions", "supersedes", "superseded_by", "licence_and_access", "generated_content"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "standard": {"$ref": "#/$defs/versionedIdentifier"},
    "artifact_id": {"type": "string", "minLength": 3, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "title": {"type": "string", "minLength": 1},
    "artifact_type": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "date": {"type": "string", "format": "date"},
    "owner": {"type": "string", "minLength": 1},
    "authority_status": {"enum": ["candidate", "admitted", "authoritative", "superseded", "withdrawn"]},
    "promotion_status": {"enum": ["working_draft", "registered", "review_ready", "in_review", "verified", "promoted", "published", "superseded", "withdrawn"]},
    "primary_profile": {"$ref": "#/$defs/profile"},
    "secondary_profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}, "uniqueItems": true},
    "impact_class": {"enum": ["IC-0", "IC-1", "IC-2", "IC-3"]},
    "audience": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "scope": {"type": "string", "minLength": 1},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_location": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "terminology_registry": {"$ref": "#/$defs/locationOrNotApplicable"},
    "notation_registry": {"$ref": "#/$defs/locationOrNotApplicable"},
    "claim_register": {"$ref": "#/$defs/locationOrExplicitEmpty"},
    "evidence_register": {"$ref": "#/$defs/locationOrExplicitEmpty"},
    "review_register": {"type": "array", "items": {"$ref": "#/$defs/reviewReference"}},
    "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exceptionReference"}},
    "conformance_dimensions": {"type": "object", "additionalProperties": false, "required": ["L", "T", "S", "C", "E", "R", "P", "V", "G"], "properties": {"L": {"$ref": "#/$defs/assessmentState"}, "T": {"$ref": "#/$defs/assessmentState"}, "S": {"$ref": "#/$defs/assessmentState"}, "C": {"$ref": "#/$defs/assessmentState"}, "E": {"$ref": "#/$defs/assessmentState"}, "R": {"$ref": "#/$defs/assessmentState"}, "P": {"$ref": "#/$defs/assessmentState"}, "V": {"$ref": "#/$defs/assessmentState"}, "G": {"$ref": "#/$defs/assessmentState"}}},
    "supersedes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "superseded_by": {"type": ["string", "null"], "minLength": 1},
    "licence_and_access": {"type": "object", "additionalProperties": false, "required": ["licence", "access"], "properties": {"licence": {"type": "string", "minLength": 1}, "access": {"type": "string", "minLength": 1}}},
    "generated_content": {"type": "object", "additionalProperties": false, "required": ["present", "method", "review"], "properties": {"present": {"type": "boolean"}, "method": {"type": "string"}, "review": {"type": "string", "minLength": 1}}}
  },
  "$defs": {
    "versionedIdentifier": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "profile": {"allOf": [{"$ref": "#/$defs/versionedIdentifier"}, {"properties": {"id": {"enum": ["GCL-TCS-P01", "GCL-TCS-P02", "GCL-TCS-P03", "GCL-TCS-P04", "GCL-TCS-P05", "GCL-TCS-P06", "GCL-TCS-P07"]}}}]},
    "assessmentState": {"enum": ["UNASSESSED", "DECLARED", "CHECKED", "ASSURED", "FAILED", "EXCEPTED"]},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "version_or_revision", "authority_status", "relation"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "version_or_revision": {"type": "string", "minLength": 1}, "authority_status": {"enum": ["candidate", "admitted", "authoritative", "superseded", "withdrawn"]}, "relation": {"type": "string", "minLength": 1}}},
    "locationOrNotApplicable": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "not_applicable"}, "reason": {"type": "string", "minLength": 1}}}]},
    "locationOrExplicitEmpty": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "explicit_empty"}, "reason": {"type": "string", "minLength": 1}}}]},
    "reviewReference": {"type": "object", "additionalProperties": false, "required": ["review_id", "gate_id", "location", "decision", "reviewed_revision"], "properties": {"review_id": {"type": "string", "minLength": 1}, "gate_id": {"pattern": "^G[0-9]$", "type": "string"}, "location": {"type": "string", "minLength": 1}, "decision": {"enum": ["PASS", "FAIL", "DEFERRED", "NOT_APPLICABLE"]}, "reviewed_revision": {"type": "string", "minLength": 1}}},
    "exceptionReference": {"type": "object", "additionalProperties": false, "required": ["exception_id", "location", "status"], "properties": {"exception_id": {"type": "string", "minLength": 1}, "location": {"type": "string", "minLength": 1}, "status": {"enum": ["requested", "approved", "rejected", "expired", "revoked", "superseded"]}}}
  }
}
