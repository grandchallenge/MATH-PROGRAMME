(* Grand Challenge Labs | RH-A26 public audit computational companion
   Wolfram Language; exact finite arithmetic and bounded numerical illustrations.
   Status: regression/explanation only. Not a proof of RH or GRH and not a Lean replay.
   Public guide: docs/domains/rh_a26_audit_explained.md
   Source references: MATHFORGE PRs #587, #591, #592, #594.
*)

ClearAll[gclExpect, gclCyclicH1, gclLocalSel, gclChi4, gclChi5,
  gclGeneralizedBernoulli, gclDenBound];

gclExpect[label_String, actual_, expected_] :=
  If[TrueQ[actual === expected],
    Print["PASS | ", label, " | ", actual],
    Print["FAIL | ", label, " | received ", actual, " | expected ", expected];
    Abort[]
  ];

(* All cocycles of C_m on F_p are z satisfying (1+a+...+a^(m-1))z=0.
   All coboundaries are (a-1)b. Only use a with a^m=1 (mod p). *)
gclCyclicH1[p_Integer, m_Integer, a_Integer] := Module[{s, z, b},
  If[!PrimeQ[p] || m < 1 || Mod[a^m, p] != 1, Return[$Failed]];
  s = Mod[Sum[PowerMod[a, k, p], {k, 0, m - 1}], p];
  z = Select[Range[0, p - 1], Mod[s #, p] == 0 &];
  b = Union[Mod[(a - 1) Range[0, p - 1], p]];
  <|"cocycles" -> z, "coboundaries" -> b, "H1Order" -> Length[z]/Length[b]|>
];

gclExpect["C3 over F3: H1 has three classes",
  gclCyclicH1[3, 3, 1]["H1Order"], 3];
gclExpect["C2 over F3: H1 is trivial",
  gclCyclicH1[3, 2, 1]["H1Order"], 1];
gclExpect["C4 over F5 with scalar 2: H1 is trivial",
  gclCyclicH1[5, 4, 2]["H1Order"], 1];
gclExpect["C2 over F2: excluded-index H1 has two classes",
  gclCyclicH1[2, 2, 1]["H1Order"], 2];

(* Finite local-kernel restriction: C_n -> subgroup generated by m;
   D is generated by d, for m|n and d|n. *)
gclLocalSel[p_Integer, n_Integer, m_Integer, d_Integer] :=
 Module[{q, k, old, new, image},
  If[!PrimeQ[p] || !Divisible[n, m] || !Divisible[n, d], Return[$Failed]];
  q = n/m;
  k = LCM[m, d]/m;
  old = Select[Range[0, p - 1],
    Mod[n #, p] == 0 && Mod[d #, p] == 0 &];
  new = Select[Range[0, p - 1],
    Mod[q #, p] == 0 && Mod[k #, p] == 0 &];
  image = Union[Mod[m old, p]];
  <|"old" -> old, "image" -> image, "descended" -> new|>
 ];
gclExpect["prime-to-index local kernels agree",
  gclLocalSel[3, 6, 2, 3]["image"] ===
  gclLocalSel[3, 6, 2, 3]["descended"], True];
gclExpect["excluded index loses nonzero local classes",
  Length[gclLocalSel[3, 3, 3, 3]["old"]] >
  Length[gclLocalSel[3, 3, 3, 3]["descended"]], True];

(* Exact generalized Bernoulli examples. χ4 is the primitive odd character
   modulo 4; χ5 is the quadratic even character modulo 5. *)
gclChi4[a_Integer] := Which[Mod[a, 4] == 1, 1,
  Mod[a, 4] == 3, -1, True, 0];
gclChi5[a_Integer] := JacobiSymbol[a, 5];
gclGeneralizedBernoulli[k_Integer, n_Integer, chi_] :=
  n^(k - 1) Sum[chi[a] BernoulliB[k, a/n], {a, 1, n}];
gclDenBound[n_Integer, k_Integer] :=
  n Times @@ Select[Range[2, k + 1], PrimeQ];
gclExpect["B_(1,chi4)", gclGeneralizedBernoulli[1, 4, gclChi4], -1/2];
gclExpect["B_(2,chi5)", gclGeneralizedBernoulli[2, 5, gclChi5], 4/5];
gclExpect["sufficient denominator multiplier at (4,1)",
  gclDenBound[4, 1] gclGeneralizedBernoulli[1, 4, gclChi4], -4];
gclExpect["sufficient denominator multiplier at (5,2)",
  gclDenBound[5, 2] gclGeneralizedBernoulli[2, 5, gclChi5], 24];
gclExpect["χ4 odd parity", gclChi4[3], -1];
gclExpect["χ5 even parity", gclChi5[4], 1];

(* Numerical orientation only. Sampling zeta zeros or primes cannot prove RH. *)
gclExpect["number of primes <= 1000", PrimePi[1000], 168];
gclExpect["Riemann R(1000) near 168.359446",
  Abs[N[RiemannR[1000], 18] - 168.3594462811631] < 10^-10, True];

Print["COMPLETE | 14 independent checks passed; bounded arithmetic only."];
