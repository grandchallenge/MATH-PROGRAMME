import Mathlib.GroupTheory.FreeAbelianGroup
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.Ring


/-!
# CMDG CM5: universal quadratic-parity obstruction to incomplete F₃

For any additive character χ : A → Z/2, the coefficient functional on
the free commutativity generator (a,b) given by χ(a)*χ(b) kills
the pentagon, hexagon, and symmetry-involution relations.
It detects the diagonal [a,a] whenever χ(a)=1.

Consequently no linear combination of these three coherence families
can generate the strict-commutativity diagonal for groups admitting a
nonzero mod-two character; the concrete A=ZMod 2 instance is
proved as a separate theorem. This is a general, Lean-verified
necessity result; it is not a finite-rank numerical heuristic.

Uses honest ordinary free-abelian representations of the same source
polynomial relations. The sibling CondensedAb module independently
proves the actual diagonal categorical boundary-square zero.
No general derived-real/circle or solidification-unit statement follows.
-/
noncomputable section
universe u
namespace CMDG.CondensedCM5R0.BreenDeligneParity

variable (A : Type u) [AddCommGroup A]

abbrev F2 := FreeAbelianGroup (Sum (A × (A × A)) (A × A))
abbrev F3Pent := FreeAbelianGroup (A × (A × (A × A)))
abbrev F3Hex := FreeAbelianGroup (A × (A × A))
abbrev F3Sym := FreeAbelianGroup (A × A)

def parity (χ : A →+ ZMod 2) : F2 A →+ ZMod 2 :=
  FreeAbelianGroup.lift fun s =>
    match s with
    | .inl _ => 0
    | .inr (a,b) => χ a * χ b

def pent (A : Type u) [AddCommGroup A] : F3Pent A →+ F2 A :=
  FreeAbelianGroup.lift fun ⟨a,⟨b,⟨c,d⟩⟩⟩ =>
    FreeAbelianGroup.of (Sum.inl (b,(c,d))) -
    FreeAbelianGroup.of (Sum.inl (a+b,(c,d))) +
    FreeAbelianGroup.of (Sum.inl (a,(b+c,d))) -
    FreeAbelianGroup.of (Sum.inl (a,(b,c+d))) +
    FreeAbelianGroup.of (Sum.inl (a,(b,c)))

def hex (A : Type u) [AddCommGroup A] : F3Hex A →+ F2 A :=
  FreeAbelianGroup.lift fun ⟨a,⟨b,c⟩⟩ =>
    FreeAbelianGroup.of (Sum.inl (a,(b,c))) -
    FreeAbelianGroup.of (Sum.inl (b,(a,c))) +
    FreeAbelianGroup.of (Sum.inl (b,(c,a))) -
    FreeAbelianGroup.of (Sum.inr (a,b+c)) +
    FreeAbelianGroup.of (Sum.inr (a,b)) +
    FreeAbelianGroup.of (Sum.inr (a,c))

def sym (A : Type u) [AddCommGroup A] : F3Sym A →+ F2 A :=
  FreeAbelianGroup.lift fun ⟨a,b⟩ =>
    FreeAbelianGroup.of (Sum.inr (a,b)) +
    FreeAbelianGroup.of (Sum.inr (b,a))

def diag (A : Type u) [AddCommGroup A] : FreeAbelianGroup A →+ F2 A :=
  FreeAbelianGroup.lift fun a => FreeAbelianGroup.of (Sum.inr (a,a))

theorem parity_pent_zero (χ : A →+ ZMod 2) :
    (parity A χ).comp (pent A) = 0 := by
  apply FreeAbelianGroup.lift_ext
  rintro ⟨a,⟨b,⟨c,d⟩⟩⟩
  simp [parity,pent]

theorem parity_hex_zero (χ : A →+ ZMod 2) :
    (parity A χ).comp (hex A) = 0 := by
  apply FreeAbelianGroup.lift_ext
  rintro ⟨a,⟨b,c⟩⟩
  simp [parity,hex,χ.map_add]
  have hchar : (2 : ZMod 2) = 0 := by decide
  ring_nf
  all_goals simp [hchar]

theorem parity_sym_zero (χ : A →+ ZMod 2) :
    (parity A χ).comp (sym A) = 0 := by
  apply FreeAbelianGroup.lift_ext
  rintro ⟨a,b⟩
  simp [parity,sym,mul_comm]
  have hchar : (2 : ZMod 2) = 0 := by decide
  rw [← two_mul, hchar, zero_mul]

theorem parity_diag (χ : A →+ ZMod 2) (a : A) :
    parity A χ (diag A (FreeAbelianGroup.of a)) =
      χ a * χ a := by
  simp [parity,diag]

/-- The diagonal class is NOT generated by the three earlier coherence
families whenever the abelian group admits a nontrivial mod-2 character.
This is a universal algebraic obstruction, not a finite-rank heuristic. -/
theorem diagonal_not_generated_without_strict_symmetry
    (χ : A →+ ZMod 2) (a : A) (ha : χ a = 1)
    (p : F3Pent A) (h : F3Hex A) (s : F3Sym A) :
    pent A p + hex A h + sym A s ≠
      diag A (FreeAbelianGroup.of a) := by
  intro heq
  have hp : parity A χ (pent A p) = 0 := by
    have h := congrArg
      (fun g : F3Pent A →+ ZMod 2 => g p)
      (parity_pent_zero A χ)
    simpa only [AddMonoidHom.comp_apply,AddMonoidHom.zero_apply] using h
  have hh : parity A χ (hex A h) = 0 := by
    have h' := congrArg
      (fun g : F3Hex A →+ ZMod 2 => g h)
      (parity_hex_zero A χ)
    simpa only [AddMonoidHom.comp_apply,AddMonoidHom.zero_apply] using h'
  have hs : parity A χ (sym A s) = 0 := by
    have h' := congrArg
      (fun g : F3Sym A →+ ZMod 2 => g s)
      (parity_sym_zero A χ)
    simpa only [AddMonoidHom.comp_apply,AddMonoidHom.zero_apply] using h'
  have heval := congrArg (fun x : F2 A => parity A χ x) heq
  rw [map_add,map_add,hp,hh,hs,parity_diag,ha] at heval
  norm_num at heval

/-- Concrete exact counterexample to omitting the diagonal at A=Z/2. -/
theorem zmod2_diagonal_not_generated
    (p : F3Pent (ZMod 2))
    (h : F3Hex (ZMod 2))
    (s : F3Sym (ZMod 2)) :
    pent (ZMod 2) p + hex (ZMod 2) h + sym (ZMod 2) s ≠
      diag (ZMod 2) (FreeAbelianGroup.of (1 : ZMod 2)) := by
  exact diagonal_not_generated_without_strict_symmetry
    (ZMod 2) (AddMonoidHom.id (ZMod 2)) 1 (by rfl) p h s

#print axioms diagonal_not_generated_without_strict_symmetry
#print axioms zmod2_diagonal_not_generated

#print axioms parity_pent_zero
#print axioms parity_hex_zero
#print axioms parity_sym_zero
#print axioms parity_diag
end CMDG.CondensedCM5R0.BreenDeligneParity
