{"schema_version":"1.0.0","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","rows":[{"id":"N-2-01","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"2","normative_requirement":"A promoted artifact must not depend on unregistered scratch as its only authority.","source_match":"must not depend on an unregistered scratch note","machine_representation":"normative_source_contract.scratch_boundary","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"hybrid","gap":"CLOSED"},{"id":"N-4.1-01","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.1","normative_requirement":"A writing rule MUST NOT change technical meaning.","source_match":"MUST NOT change the technical meaning","machine_representation":"principles.PR-01 + normative_obligations.correctness_preservation","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"review","gap":"CLOSED"},{"id":"N-4.1-02","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.1","normative_requirement":"When clarity and precision conflict, the author MUST first attempt a structural solution.","source_match":"MUST first try a structural solution","machine_representation":"normative_obligations.structural_solution_before_exception","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"review","gap":"CLOSED"},{"id":"N-4.2-01","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.2","normative_requirement":"A document MUST distinguish established results from hypotheses, interpretations, recommendations, and speculation.","source_match":"MUST distinguish established results","machine_representation":"normative_obligations.claim_boundary_distinction","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"hybrid","gap":"CLOSED"},{"id":"N-4.2-02","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.2","normative_requirement":"Presentation quality MUST NOT raise claim status.","source_match":"Presentation quality MUST NOT raise","machine_representation":"normative_obligations.no_presentation_promotion","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"review","gap":"CLOSED"},{"id":"N-4.2-03","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.2","normative_requirement":"Public explanations MUST preserve source claim status, scope, assumptions, and important limitations.","source_match":"public explanation MUST preserve","machine_representation":"normative_obligations.public_source_claim_preservation","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"hybrid","gap":"CLOSED"},{"id":"N-4.3-01","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.3","normative_requirement":"A consequential claim MUST link to evidence or accepted derivation.","source_match":"consequential claim MUST link","machine_representation":"record_contracts.claim.supporting_evidence + fail_closed_conditions.missing_claim_ledger","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"machine","gap":"CLOSED"},{"id":"N-4.3-02","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.3","normative_requirement":"Evidence MUST be sufficient for declared claim type and impact class.","source_match":"evidence MUST be sufficient","machine_representation":"normative_obligations.evidence_sufficiency","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"review","gap":"CLOSED"},{"id":"N-4.4-01","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.4","normative_requirement":"Empirical or computational results MUST provide enough information to repeat the relevant procedure.","source_match":"result MUST provide enough information to repeat","machine_representation":"profiles.GCL-TCS-P04 + normative_obligations.reproducibility_information","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"hybrid","gap":"CLOSED"},{"id":"N-4.4-02","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.4","normative_requirement":"If full reproduction is impossible, the artifact MUST state why and provide the strongest available substitute.","source_match":"artifact MUST state why and provide","machine_representation":"normative_obligations.reproducibility_limitation_substitute","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"review","gap":"CLOSED"},{"id":"N-4.5-01","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.5","normative_requirement":"When synonyms are used, the document MUST identify the canonical term.","source_match":"document MUST identify the canonical term","machine_representation":"normative_obligations.canonical_term_identification","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"review","gap":"CLOSED"},{"id":"N-4.6-01","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.6","normative_requirement":"An artifact MUST state material uncertainty, unresolved proof debt, missing controls, unsupported assumptions, and known failure cases.","source_match":"artifact MUST state material uncertainty","machine_representation":"normative_obligations.explicit_uncertainty","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"review","gap":"CLOSED"},{"id":"N-4.6-02","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.6","normative_requirement":"An artifact MUST NOT use silence to imply that an unresolved question is settled.","source_match":"MUST NOT use silence","machine_representation":"normative_obligations.no_silence_as_resolution","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"review","gap":"CLOSED"},{"id":"N-4.7-01","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.7","normative_requirement":"The promotion system MUST fail closed.","source_match":"promotion system MUST fail closed","machine_representation":"normative_obligations.fail_closed_promotion + fail_closed_conditions","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"machine","gap":"CLOSED"},{"id":"N-4.7-02","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.7","normative_requirement":"Missing mandatory metadata, ledgers, reviews, hashes, or exception records MUST block the applicable gate.","source_match":"exception records MUST block","machine_representation":"fail_closed_conditions + record_contracts","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"machine","gap":"CLOSED"},{"id":"N-4.7-03","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.7","normative_requirement":"A tool MUST NOT infer promotion state from display text.","source_match":"tool MUST NOT infer a promotion state","machine_representation":"normative_obligations.machine_status_controls_display","validator_test":"tests/test_gcl_tcs_normative_agreement.py","machine_checkability":"machine","gap":"CLOSED"},{"id":"S-4.5-01","source":"council_submissions/GCL-TCS-00/parts/00-frontmatter-purpose-principles.md","section":"4.5","normative_requirement":"A technical object SHOULD have one canonical project name.","source_match":"technical object SHOULD have one canonical name","machine_representation":"strong_defaults.canonical_name",