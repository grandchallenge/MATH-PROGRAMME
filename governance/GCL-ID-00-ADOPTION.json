      "inverse_problem",
      "parameter_reconstruction",
      "latent_state_recovery",
      "geometric_reconstruction",
      "calibration_recovery",
      "learned_inverse_map",
      "system_identification"
    ],
    "exclusions": [
      "ordinary_forward_computation",
      "theorem_proving_without_reconstruction_claim",
      "numerical_evaluation_without_latent_recovery",
      "exploratory_work_without_representative_recovery_claim"
    ],
    "grandfathering": "No retrospective rewrite is required. Existing work enters scope only at a new material inverse/reconstruction tranche or when it makes a new recovery claim."
  },
  "levels": {
    "default": "ID-PREFLIGHT-LITE",
    "lite": {
