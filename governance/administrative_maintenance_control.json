  "material_change_classification": {
    "material_changes": [
      "semantic change to authority lifecycle route claim or promotion state",
      "new or changed provider manifest campaign manifest handoff route adjudication or certificate output",
      "new or changed content consumed as an exact provider contract",
      "required workflow or branch-protection change",
      "change that alters accepted evidence or prohibited uses"
    ],
    "nonmaterial_changes": [
      "repository head movement that leaves consumed artifact blobs unchanged",
      "issue mirror refresh that preserves protected state",
      "typographic or explanatory change without semantic or evidence effect",
      "external attestation that records an already reviewed merge without changing protected contract meaning"
    ],
    "classification_evidence_required": true,
    "uncertain_classification_disposition": "ESCALATE_AND_FAIL_CLOSED"
  },
  "workflow_coverage_requirements": {
    "coverage_definition": "A workflow is covered only when its purpose, trigger, required-check status, exact-head execution, evidence retention, failure preservation, owner, and repair route are recorded.",
